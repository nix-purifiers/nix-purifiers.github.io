2026-11-07T11:51:13.3488828Z #fi
2026-11-07T11:51:13.3488988Z 
2026-11-07T11:51:13.3489073Z # sudo hint
2026-11-07T11:51:13.3489444Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T11:51:13.3489906Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T11:51:13.3490614Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T11:51:13.3490983Z 	cat <<-EOF
2026-11-07T11:51:13.3491910Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T11:51:13.3492619Z 	See "man sudo_root" for details.
2026-11-07T11:51:13.3492894Z 	
2026-11-07T11:51:13.3493090Z 	EOF
2026-11-07T11:51:13.3493363Z     fi
2026-11-07T11:51:13.3493569Z     esac
2026-11-07T11:51:13.3493786Z fi
2026-11-07T11:51:13.3493924Z 
2026-11-07T11:51:13.3494091Z # if the command-not-found package is installed, use it
2026-11-07T11:51:13.3494584Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:13.3495123Z 	function command_not_found_handle {
2026-11-07T11:51:13.3495479Z 	        # check because c-n-f could've been removed in the meantime
2026-11-07T11:51:13.3495888Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-07T11:51:13.3496235Z 		   /usr/lib/command-not-found -- "$1"
2026-11-07T11:51:13.3496527Z                    return $?
2026-11-07T11:51:13.3496931Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:13.3497394Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-07T11:51:13.3497756Z                    return $?
2026-11-07T11:51:13.3498018Z 		else
