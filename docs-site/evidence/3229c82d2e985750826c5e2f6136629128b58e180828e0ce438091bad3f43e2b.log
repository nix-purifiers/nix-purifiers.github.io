2026-11-07T06:33:14.2999188Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:14.2999456Z 
2026-11-07T06:33:14.2999655Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:14.3000118Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:14.3000363Z 
2026-11-07T06:33:14.3000509Z # If not running interactively, don't do anything
2026-11-07T06:33:14.3000849Z [ -z "$PS1" ] && return
2026-11-07T06:33:14.3000998Z 
2026-11-07T06:33:14.3001152Z # check the window size after each command and, if necessary,
2026-11-07T06:33:14.3001563Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:14.3001846Z shopt -s checkwinsize
2026-11-07T06:33:14.3002008Z 
2026-11-07T06:33:14.3002226Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:14.3002696Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:14.3003071Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:14.3003346Z fi
2026-11-07T06:33:14.3003448Z 
2026-11-07T06:33:14.3003632Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:14.3004102Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:14.3004543Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:14.3004886Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:14.3005182Z fi
2026-11-07T06:33:14.3005304Z 
2026-11-07T06:33:14.3005513Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:14.3005962Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:14.3006257Z #case "$TERM" in
2026-11-07T06:33:14.3006722Z #xterm*|rxvt*)
2026-11-07T06:33:14.3007327Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:14.3007840Z #    ;;
2026-11-07T06:33:14.3008151Z #*)
2026-11-07T06:33:14.3008437Z #    ;;
2026-11-07T06:33:14.3008731Z #esac
2026-11-07T06:33:14.3008903Z 
2026-11-07T06:33:14.3009107Z # enable bash completion in interactive shells
2026-11-07T06:33:14.3009632Z #if ! shopt -oq posix; then
2026-11-07T06:33:14.3010136Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-07T06:33:14.3010755Z #    . /usr/share/bash-completion/bash_completion
2026-11-07T06:33:14.3011128Z #  elif [ -f /etc/bash_completion ]; then
2026-11-07T06:33:14.3011405Z #    . /etc/bash_completion
2026-11-07T06:33:14.3011622Z #  fi
2026-11-07T06:33:14.3011793Z #fi
2026-11-07T06:33:14.3011891Z 
2026-11-07T06:33:14.3011965Z # sudo hint
2026-11-07T06:33:14.3012280Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:14.3012883Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T06:33:14.3013184Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T06:33:14.3013458Z 	cat <<-EOF
2026-11-07T06:33:14.3013967Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T06:33:14.3014722Z 	See "man sudo_root" for details.
2026-11-07T06:33:14.3015114Z 	
