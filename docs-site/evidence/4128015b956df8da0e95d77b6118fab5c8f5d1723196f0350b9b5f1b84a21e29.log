2026-11-06T03:19:01.8158098Z fi
2026-11-06T03:19:01.8158198Z 
2026-11-06T03:19:01.8158327Z # if the command-not-found package is installed, use it
2026-11-06T03:19:01.8158901Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:19:01.8159305Z 	function command_not_found_handle {
2026-11-06T03:19:01.8159606Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:19:01.8159950Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:19:01.8160227Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:19:01.8160466Z                    return $?
2026-11-06T03:19:01.8160776Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:19:01.8161144Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:19:01.8161426Z                    return $?
2026-11-06T03:19:01.8161643Z 		else
2026-11-06T03:19:01.8161846Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:19:01.8162095Z 		   return 127
2026-11-06T03:19:01.8162277Z 		fi
2026-11-06T03:19:01.8162445Z 	}
