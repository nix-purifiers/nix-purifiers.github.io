2026-11-07T05:45:13.0427174Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T05:45:13.0427471Z 
2026-11-07T05:45:13.0427717Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T05:45:13.0428056Z # this file has to be sourced in /etc/profile.
2026-11-07T05:45:13.0428226Z 
2026-11-07T05:45:13.0428337Z # If not running interactively, don't do anything
2026-11-07T05:45:13.0428600Z [ -z "$PS1" ] && return
2026-11-07T05:45:13.0428724Z 
2026-11-07T05:45:13.0428854Z # check the window size after each command and, if necessary,
2026-11-07T05:45:13.0429148Z # update the values of LINES and COLUMNS.
2026-11-07T05:45:13.0429386Z shopt -s checkwinsize
2026-11-07T05:45:13.0429506Z 
2026-11-07T05:45:13.0429682Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T05:45:13.0430058Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T05:45:13.0430354Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T05:45:13.0430581Z fi
2026-11-07T05:45:13.0430674Z 
2026-11-07T05:45:13.0430824Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T05:45:13.0431186Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T05:45:13.0431512Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T05:45:13.0431802Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T05:45:13.0432047Z fi
2026-11-07T05:45:13.0432128Z 
2026-11-07T05:45:13.0432300Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T05:45:13.0432636Z # If this is an xterm set the title to user@host:dir
2026-11-07T05:45:13.0432878Z #case "$TERM" in
2026-11-07T05:45:13.0433084Z #xterm*|rxvt*)
2026-11-07T05:45:13.0433339Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
