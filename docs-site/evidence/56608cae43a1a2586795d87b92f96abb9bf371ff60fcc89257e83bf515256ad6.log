2026-11-07T11:51:12.3950658Z 
2026-11-07T11:51:12.3950728Z # sudo hint
2026-11-07T11:51:12.3950978Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T11:51:12.3951502Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T11:51:12.3951753Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T11:51:12.3951950Z 	cat <<-EOF
2026-11-07T11:51:12.3952184Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T11:51:12.3952596Z 	See "man sudo_root" for details.
2026-11-07T11:51:12.3953019Z 	
2026-11-07T11:51:12.3953211Z 	EOF
2026-11-07T11:51:12.3953410Z     fi
