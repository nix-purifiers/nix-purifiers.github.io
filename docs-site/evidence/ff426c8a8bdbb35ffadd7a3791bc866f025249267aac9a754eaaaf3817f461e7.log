2026-11-06T02:59:51.9023142Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:59:51.9023268Z 
2026-11-06T02:59:51.9023411Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:59:51.9023740Z # this file has to be sourced in /etc/profile.
2026-11-06T02:59:51.9023908Z 
2026-11-06T02:59:51.9024014Z # If not running interactively, don't do anything
2026-11-06T02:59:51.9024275Z [ -z "$PS1" ] && return
2026-11-06T02:59:51.9024396Z 
2026-11-06T02:59:51.9024528Z # check the window size after each command and, if necessary,
2026-11-06T02:59:51.9024815Z # update the values of LINES and COLUMNS.
2026-11-06T02:59:51.9025049Z shopt -s checkwinsize
2026-11-06T02:59:51.9025160Z 
2026-11-06T02:59:51.9025337Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:59:51.9025714Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:59:51.9026005Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:59:51.9026225Z fi
2026-11-06T02:59:51.9026311Z 
2026-11-06T02:59:51.9026454Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:59:51.9026840Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:59:51.9027168Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:59:51.9027439Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:59:51.9027667Z fi
2026-11-06T02:59:51.9027746Z 
2026-11-06T02:59:51.9027942Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:59:51.9028286Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:59:51.9028526Z #case "$TERM" in
2026-11-06T02:59:51.9028693Z #xterm*|rxvt*)
2026-11-06T02:59:51.9028937Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:59:51.9029221Z #    ;;
2026-11-06T02:59:51.9029365Z #*)
2026-11-06T02:59:51.9029512Z #    ;;
2026-11-06T02:59:51.9029662Z #esac
2026-11-06T02:59:51.9029752Z 
2026-11-06T02:59:51.9029854Z # enable bash completion in interactive shells
2026-11-06T02:59:51.9030114Z #if ! shopt -oq posix; then
2026-11-06T02:59:51.9030353Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:59:51.9030543Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:59:51.9030723Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T02:59:51.9030890Z #    . /etc/bash_completion
2026-11-06T02:59:51.9031008Z #  fi
2026-11-06T02:59:51.9031101Z #fi
2026-11-06T02:59:51.9031155Z 
2026-11-06T02:59:51.9031197Z # sudo hint
2026-11-06T02:59:51.9031365Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:59:51.9031579Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:59:51.9031757Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:59:51.9031892Z 	cat <<-EOF
2026-11-06T02:59:51.9032265Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:59:51.9032568Z 	See "man sudo_root" for details.
2026-11-06T02:59:51.9032763Z 	
2026-11-06T02:59:51.9033252Z 	EOF
2026-11-06T02:59:51.9033396Z     fi
2026-11-06T02:59:51.9033678Z     esac
2026-11-06T02:59:51.9033856Z fi
2026-11-06T02:59:51.9033972Z 
2026-11-06T02:59:51.9034153Z # if the command-not-found package is installed, use it
2026-11-06T02:59:51.9034532Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:59:51.9034769Z 	function command_not_found_handle {
2026-11-06T02:59:51.9034949Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:59:51.9035146Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:59:51.9035312Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:59:51.9035453Z                    return $?
2026-11-06T02:59:51.9035625Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:59:51.9035844Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:59:51.9036011Z                    return $?
2026-11-06T02:59:51.9036127Z 		else
2026-11-06T02:59:51.9036245Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:59:51.9036391Z 		   return 127
