          "name": "JDK",
          "kind": "nix-scope",
          "inputs": [
            "legacyJvmAdapter"
          ],
          "description": "For legacy-basic-v1, supply a live SDK adapter with explicit manager executable and runtime home. Nix contexts retain the actual SDK inputs.",
          "sourceRevision": "4db074129b0dd2ac49fae0988804e1a327a48cfa",
          "evidence": [
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/flake.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/sdk.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/README.md"
