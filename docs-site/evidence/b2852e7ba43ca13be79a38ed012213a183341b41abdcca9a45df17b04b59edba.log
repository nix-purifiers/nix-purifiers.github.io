2026-11-06T03:20:05.8656558Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:20:05.8657038Z 
2026-11-06T03:20:05.8657393Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:20:05.8657815Z # this file has to be sourced in /etc/profile.
2026-11-06T03:20:05.8658052Z 
2026-11-06T03:20:05.8658179Z # If not running interactively, don't do anything
2026-11-06T03:20:05.8658479Z [ -z "$PS1" ] && return
2026-11-06T03:20:05.8658617Z 
2026-11-06T03:20:05.8658779Z # check the window size after each command and, if necessary,
2026-11-06T03:20:05.8659126Z # update the values of LINES and COLUMNS.
2026-11-06T03:20:05.8659409Z shopt -s checkwinsize
2026-11-06T03:20:05.8659553Z 
2026-11-06T03:20:05.8659769Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:20:05.8660258Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:20:05.8660620Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:20:05.8660883Z fi
2026-11-06T03:20:05.8660977Z 
2026-11-06T03:20:05.8661171Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:20:05.8661616Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:20:05.8662051Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:20:05.8662378Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:20:05.8662660Z fi
2026-11-06T03:20:05.8662760Z 
2026-11-06T03:20:05.8662960Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:20:05.8663384Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:20:05.8663670Z #case "$TERM" in
2026-11-06T03:20:05.8663868Z #xterm*|rxvt*)
2026-11-06T03:20:05.8664168Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:20:05.8664515Z #    ;;
2026-11-06T03:20:05.8664683Z #*)
2026-11-06T03:20:05.8664849Z #    ;;
2026-11-06T03:20:05.8665013Z #esac
2026-11-06T03:20:05.8665114Z 
2026-11-06T03:20:05.8665229Z # enable bash completion in interactive shells
2026-11-06T03:20:05.8665561Z #if ! shopt -oq posix; then
2026-11-06T03:20:05.8665868Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:20:05.8666222Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:20:05.8666792Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:20:05.8667067Z #    . /etc/bash_completion
2026-11-06T03:20:05.8667311Z #  fi
2026-11-06T03:20:05.8667504Z #fi
2026-11-06T03:20:05.8667617Z 
2026-11-06T03:20:05.8667720Z # sudo hint
2026-11-06T03:20:05.8668105Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:20:05.8668535Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:20:05.8668831Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:20:05.8669279Z 	cat <<-EOF
2026-11-06T03:20:05.8669569Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:20:05.8669930Z 	See "man sudo_root" for details.
2026-11-06T03:20:05.8670156Z 	
2026-11-06T03:20:05.8670457Z 	EOF
2026-11-06T03:20:05.8670618Z     fi
2026-11-06T03:20:05.8670784Z     esac
2026-11-06T03:20:05.8670948Z fi
2026-11-06T03:20:05.8671044Z 
2026-11-06T03:20:05.8671185Z # if the command-not-found package is installed, use it
2026-11-06T03:20:05.8671672Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:20:05.8672128Z 	function command_not_found_handle {
2026-11-06T03:20:05.8672450Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:20:05.8672815Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:20:05.8673123Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:20:05.8673383Z                    return $?
2026-11-06T03:20:05.8673702Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:20:05.8674104Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:20:05.8674406Z                    return $?
2026-11-06T03:20:05.8674613Z 		else
