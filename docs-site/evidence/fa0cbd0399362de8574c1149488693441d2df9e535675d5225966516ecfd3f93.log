2026-11-06T03:17:36.5760741Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:17:36.5761163Z 
2026-11-06T03:17:36.5761542Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:17:36.5762242Z # this file has to be sourced in /etc/profile.
2026-11-06T03:17:36.5762725Z 
2026-11-06T03:17:36.5762962Z # If not running interactively, don't do anything
2026-11-06T03:17:36.5763523Z [ -z "$PS1" ] && return
2026-11-06T03:17:36.5763771Z 
2026-11-06T03:17:36.5764049Z # check the window size after each command and, if necessary,
2026-11-06T03:17:36.5764741Z # update the values of LINES and COLUMNS.
2026-11-06T03:17:36.5765272Z shopt -s checkwinsize
2026-11-06T03:17:36.5765507Z 
2026-11-06T03:17:36.5765860Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:17:36.5766381Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:17:36.5766946Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:17:36.5767425Z fi
2026-11-06T03:17:36.5767662Z 
2026-11-06T03:17:36.5767948Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:17:36.5768716Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:17:36.5769573Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:17:36.5770147Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:17:36.5770771Z fi
2026-11-06T03:17:36.5770900Z 
2026-11-06T03:17:36.5771158Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:17:36.5771649Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:17:36.5772003Z #case "$TERM" in
2026-11-06T03:17:36.5772285Z #xterm*|rxvt*)
2026-11-06T03:17:36.5772682Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:17:36.5773156Z #    ;;
2026-11-06T03:17:36.5773433Z #*)
2026-11-06T03:17:36.5773695Z #    ;;
2026-11-06T03:17:36.5773931Z #esac
2026-11-06T03:17:36.5774079Z 
2026-11-06T03:17:36.5774300Z # enable bash completion in interactive shells
2026-11-06T03:17:36.5774696Z #if ! shopt -oq posix; then
2026-11-06T03:17:36.5775075Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:17:36.5775510Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:17:36.5775886Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:17:36.5776245Z #    . /etc/bash_completion
2026-11-06T03:17:36.5776608Z #  fi
2026-11-06T03:17:36.5776873Z #fi
2026-11-06T03:17:36.5777008Z 
2026-11-06T03:17:36.5777142Z # sudo hint
2026-11-06T03:17:36.5777520Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:17:36.5778028Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:17:36.5778656Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:17:36.5779098Z 	cat <<-EOF
2026-11-06T03:17:36.5779860Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:17:36.5780615Z 	See "man sudo_root" for details.
2026-11-06T03:17:36.5781170Z 	
2026-11-06T03:17:36.5781611Z 	EOF
2026-11-06T03:17:36.5781897Z     fi
2026-11-06T03:17:36.5782266Z     esac
2026-11-06T03:17:36.5782537Z fi
2026-11-06T03:17:36.5782694Z 
2026-11-06T03:17:36.5782916Z # if the command-not-found package is installed, use it
2026-11-06T03:17:36.5783487Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:17:36.5784070Z 	function command_not_found_handle {
2026-11-06T03:17:36.5784671Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:17:36.5785330Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:17:36.5785913Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:17:36.5786399Z                    return $?
2026-11-06T03:17:36.5786805Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:17:36.5787315Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:17:36.5787707Z                    return $?
2026-11-06T03:17:36.5788612Z 		else
