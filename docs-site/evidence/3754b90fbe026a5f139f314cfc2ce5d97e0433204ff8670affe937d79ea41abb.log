2026-11-06T03:00:49.6099582Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:00:49.6100045Z 
2026-11-06T03:00:49.6100399Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:00:49.6101115Z # this file has to be sourced in /etc/profile.
2026-11-06T03:00:49.6101373Z 
2026-11-06T03:00:49.6101498Z # If not running interactively, don't do anything
2026-11-06T03:00:49.6101855Z [ -z "$PS1" ] && return
2026-11-06T03:00:49.6101995Z 
2026-11-06T03:00:49.6102174Z # check the window size after each command and, if necessary,
2026-11-06T03:00:49.6102523Z # update the values of LINES and COLUMNS.
2026-11-06T03:00:49.6102795Z shopt -s checkwinsize
2026-11-06T03:00:49.6102925Z 
2026-11-06T03:00:49.6103138Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:00:49.6103596Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:00:49.6103951Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:00:49.6104212Z fi
2026-11-06T03:00:49.6104310Z 
2026-11-06T03:00:49.6104485Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:00:49.6104964Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:00:49.6105393Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:00:49.6105800Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:00:49.6106453Z fi
2026-11-06T03:00:49.6106629Z 
2026-11-06T03:00:49.6106987Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:00:49.6107965Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:00:49.6108510Z #case "$TERM" in
2026-11-06T03:00:49.6108853Z #xterm*|rxvt*)
2026-11-06T03:00:49.6109289Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:00:49.6109655Z #    ;;
2026-11-06T03:00:49.6109826Z #*)
2026-11-06T03:00:49.6109991Z #    ;;
2026-11-06T03:00:49.6110183Z #esac
2026-11-06T03:00:49.6110294Z 
2026-11-06T03:00:49.6110420Z # enable bash completion in interactive shells
2026-11-06T03:00:49.6110735Z #if ! shopt -oq posix; then
2026-11-06T03:00:49.6111087Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:00:49.6111554Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:00:49.6111915Z #  elif [ -f /etc/bash_completion ]; then
