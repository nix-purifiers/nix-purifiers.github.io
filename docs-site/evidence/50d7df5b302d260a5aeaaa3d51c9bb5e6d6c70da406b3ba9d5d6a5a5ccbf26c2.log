2026-11-06T02:56:57.9394418Z # sudo hint
2026-11-06T02:56:57.9394805Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:56:57.9395236Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:56:57.9395918Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:56:57.9396279Z 	cat <<-EOF
2026-11-06T02:56:57.9396701Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:56:57.9397195Z 	See "man sudo_root" for details.
2026-11-06T02:56:57.9397649Z 	
2026-11-06T02:56:57.9397846Z 	EOF
