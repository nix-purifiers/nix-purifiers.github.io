          ]
        },
        {
          "text": "The recorded macOS SDK profile uses pinned Swift and Apple SDK packages rather than Xcode. That profile has no XCTest runner, so its project tests output is not run.",
          "sourceRevision": "cd52ed8444afc1561ec1289a7ead04d6a2556ea0",
          "evidence": [
            "https://github.com/nix-purifiers/swiftpm-purifier/blob/cd52ed8444afc1561ec1289a7ead04d6a2556ea0/flake.nix",
            "https://github.com/nix-purifiers/swiftpm-purifier/blob/cd52ed8444afc1561ec1289a7ead04d6a2556ea0/pkgs/toolchain/default.nix"
          ]
        }
      ],
