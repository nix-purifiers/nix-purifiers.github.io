2026-11-07T11:51:14.7976367Z # sudo hint
2026-11-07T11:51:14.7976735Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T11:51:14.7977176Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T11:51:14.7978090Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T11:51:14.7978557Z 	cat <<-EOF
2026-11-07T11:51:14.7978881Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T11:51:14.7979460Z 	See "man sudo_root" for details.
2026-11-07T11:51:14.7979811Z 	
2026-11-07T11:51:14.7980008Z 	EOF
