2026-11-13T10:02:14.9256880Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-13T10:02:14.9257062Z 
2026-11-13T10:02:14.9257340Z # To enable the settings / commands in this file for login shells as well,
2026-11-13T10:02:14.9257775Z # this file has to be sourced in /etc/profile.
2026-11-13T10:02:14.9257936Z 
2026-11-13T10:02:14.9258040Z # If not running interactively, don't do anything
2026-11-13T10:02:14.9258290Z [ -z "$PS1" ] && return
2026-11-13T10:02:14.9258411Z 
2026-11-13T10:02:14.9258537Z # check the window size after each command and, if necessary,
2026-11-13T10:02:14.9258810Z # update the values of LINES and COLUMNS.
2026-11-13T10:02:14.9259039Z shopt -s checkwinsize
2026-11-13T10:02:14.9259146Z 
2026-11-13T10:02:14.9259313Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-13T10:02:14.9259671Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-13T10:02:14.9259947Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-13T10:02:14.9260182Z fi
2026-11-13T10:02:14.9260265Z 
2026-11-13T10:02:14.9260408Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-13T10:02:14.9260747Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-13T10:02:14.9261069Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-13T10:02:14.9261353Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-13T10:02:14.9261567Z fi
2026-11-13T10:02:14.9261647Z 
2026-11-13T10:02:14.9262015Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-13T10:02:14.9262341Z # If this is an xterm set the title to user@host:dir
2026-11-13T10:02:14.9262568Z #case "$TERM" in
2026-11-13T10:02:14.9262741Z #xterm*|rxvt*)
2026-11-13T10:02:14.9262987Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-13T10:02:14.9263249Z #    ;;
2026-11-13T10:02:14.9263397Z #*)
2026-11-13T10:02:14.9263537Z #    ;;
2026-11-13T10:02:14.9263673Z #esac
2026-11-13T10:02:14.9263763Z 
