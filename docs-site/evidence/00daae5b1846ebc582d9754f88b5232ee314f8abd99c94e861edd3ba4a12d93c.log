2026-11-06T03:01:28.4988150Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:01:28.4988902Z 
2026-11-06T03:01:28.4989294Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:01:28.4989952Z # this file has to be sourced in /etc/profile.
2026-11-06T03:01:28.4990273Z 
2026-11-06T03:01:28.4990459Z # If not running interactively, don't do anything
2026-11-06T03:01:28.4990929Z [ -z "$PS1" ] && return
2026-11-06T03:01:28.4991157Z 
2026-11-06T03:01:28.4991440Z # check the window size after each command and, if necessary,
2026-11-06T03:01:28.4992042Z # update the values of LINES and COLUMNS.
2026-11-06T03:01:28.4992511Z shopt -s checkwinsize
2026-11-06T03:01:28.4992720Z 
2026-11-06T03:01:28.4993063Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:01:28.4994145Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:01:28.4994708Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:01:28.4994972Z fi
2026-11-06T03:01:28.4995065Z 
2026-11-06T03:01:28.4995241Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:01:28.4995749Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:01:28.4996139Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:01:28.4996496Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:01:28.4996823Z fi
2026-11-06T03:01:28.4996969Z 
2026-11-06T03:01:28.4997271Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:01:28.4997871Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:01:28.4998423Z #case "$TERM" in
2026-11-06T03:01:28.4998771Z #xterm*|rxvt*)
2026-11-06T03:01:28.4999242Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:01:28.4999835Z #    ;;
2026-11-06T03:01:28.5000278Z #*)
2026-11-06T03:01:28.5000579Z #    ;;
2026-11-06T03:01:28.5000755Z #esac
2026-11-06T03:01:28.5000861Z 
2026-11-06T03:01:28.5000991Z # enable bash completion in interactive shells
2026-11-06T03:01:28.5001305Z #if ! shopt -oq posix; then
2026-11-06T03:01:28.5001619Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:01:28.5001966Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:01:28.5002270Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:01:28.5002560Z #    . /etc/bash_completion
2026-11-06T03:01:28.5002779Z #  fi
2026-11-06T03:01:28.5002965Z #fi
2026-11-06T03:01:28.5003065Z 
2026-11-06T03:01:28.5003152Z # sudo hint
2026-11-06T03:01:28.5003461Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:01:28.5003870Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:01:28.5004149Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:01:28.5004386Z 	cat <<-EOF
2026-11-06T03:01:28.5004877Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:01:28.5005255Z 	See "man sudo_root" for details.
2026-11-06T03:01:28.5005509Z 	
2026-11-06T03:01:28.5005674Z 	EOF
2026-11-06T03:01:28.5005850Z     fi
2026-11-06T03:01:28.5006120Z     esac
2026-11-06T03:01:28.5006291Z fi
2026-11-06T03:01:28.5006392Z 
2026-11-06T03:01:28.5006540Z # if the command-not-found package is installed, use it
2026-11-06T03:01:28.5007020Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:01:28.5007469Z 	function command_not_found_handle {
2026-11-06T03:01:28.5007798Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:01:28.5008334Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:01:28.5008680Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:01:28.5008948Z                    return $?
2026-11-06T03:01:28.5009264Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:01:28.5009677Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:01:28.5009988Z                    return $?
2026-11-06T03:01:28.5010202Z 		else
2026-11-06T03:01:28.5010413Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:01:28.5010687Z 		   return 127
2026-11-06T03:01:28.5010874Z 		fi
2026-11-06T03:01:28.5011039Z 	}
