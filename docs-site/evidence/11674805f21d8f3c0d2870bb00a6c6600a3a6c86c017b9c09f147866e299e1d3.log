2026-11-13T10:02:14.9268183Z 
2026-11-13T10:02:14.9268414Z # if the command-not-found package is installed, use it
2026-11-13T10:02:14.9268788Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-13T10:02:14.9269151Z 	function command_not_found_handle {
2026-11-13T10:02:14.9269411Z 	        # check because c-n-f could've been removed in the meantime
2026-11-13T10:02:14.9269702Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-13T10:02:14.9269953Z 		   /usr/lib/command-not-found -- "$1"
2026-11-13T10:02:14.9270162Z                    return $?
2026-11-13T10:02:14.9270418Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-13T10:02:14.9270735Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-13T10:02:14.9270977Z                    return $?
2026-11-13T10:02:14.9271145Z 		else
2026-11-13T10:02:14.9271315Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-13T10:02:14.9271526Z 		   return 127
2026-11-13T10:02:14.9271680Z 		fi
2026-11-13T10:02:14.9272026Z 	}
