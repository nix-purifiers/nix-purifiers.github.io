2026-11-07T06:33:14.3252733Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:14.3253182Z 
2026-11-07T06:33:14.3253479Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:14.3254102Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:14.3254530Z 
2026-11-07T06:33:14.3254792Z # If not running interactively, don't do anything
2026-11-07T06:33:14.3255332Z [ -z "$PS1" ] && return
2026-11-07T06:33:14.3255531Z 
2026-11-07T06:33:14.3255894Z # check the window size after each command and, if necessary,
2026-11-07T06:33:14.3256556Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:14.3257351Z shopt -s checkwinsize
2026-11-07T06:33:14.3257770Z 
2026-11-07T06:33:14.3258051Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:14.3258655Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:14.3259206Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:14.3259772Z fi
2026-11-07T06:33:14.3259935Z 
2026-11-07T06:33:14.3260244Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:14.3261046Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:14.3262045Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:14.3262484Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:14.3262886Z fi
2026-11-07T06:33:14.3263052Z 
2026-11-07T06:33:14.3263301Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:14.3264050Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:14.3264448Z #case "$TERM" in
2026-11-07T06:33:14.3264776Z #xterm*|rxvt*)
2026-11-07T06:33:14.3265172Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:14.3265587Z #    ;;
2026-11-07T06:33:14.3265866Z #*)
2026-11-07T06:33:14.3266128Z #    ;;
2026-11-07T06:33:14.3266398Z #esac
2026-11-07T06:33:14.3266593Z 
2026-11-07T06:33:14.3266742Z # enable bash completion in interactive shells
