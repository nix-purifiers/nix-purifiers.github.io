2026-11-07T05:17:01.9331970Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T05:17:01.9332465Z 
2026-11-07T05:17:01.9332753Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T05:17:01.9333348Z # this file has to be sourced in /etc/profile.
2026-11-07T05:17:01.9333602Z 
2026-11-07T05:17:01.9333748Z # If not running interactively, don't do anything
2026-11-07T05:17:01.9334119Z [ -z "$PS1" ] && return
2026-11-07T05:17:01.9334292Z 
2026-11-07T05:17:01.9334479Z # check the window size after each command and, if necessary,
2026-11-07T05:17:01.9334913Z # update the values of LINES and COLUMNS.
2026-11-07T05:17:01.9335254Z shopt -s checkwinsize
2026-11-07T05:17:01.9335531Z 
2026-11-07T05:17:01.9335809Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T05:17:01.9336373Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T05:17:01.9336805Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T05:17:01.9337129Z fi
2026-11-07T05:17:01.9337249Z 
2026-11-07T05:17:01.9337465Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T05:17:01.9338016Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T05:17:01.9338633Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T05:17:01.9339259Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T05:17:01.9339857Z fi
2026-11-07T05:17:01.9340049Z 
2026-11-07T05:17:01.9340694Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
