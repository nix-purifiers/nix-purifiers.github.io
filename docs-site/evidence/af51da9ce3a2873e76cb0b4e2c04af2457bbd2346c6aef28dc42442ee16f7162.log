2026-11-07T06:33:15.0393852Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:15.0394254Z 
2026-11-07T06:33:15.0394556Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:15.0394936Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:15.0395131Z 
2026-11-07T06:33:15.0395257Z # If not running interactively, don't do anything
2026-11-07T06:33:15.0395545Z [ -z "$PS1" ] && return
2026-11-07T06:33:15.0395673Z 
2026-11-07T06:33:15.0395823Z # check the window size after each command and, if necessary,
2026-11-07T06:33:15.0396184Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:15.0396437Z shopt -s checkwinsize
2026-11-07T06:33:15.0396570Z 
2026-11-07T06:33:15.0396779Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:15.0397203Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:15.0397534Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:15.0397847Z fi
2026-11-07T06:33:15.0397980Z 
2026-11-07T06:33:15.0398243Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:15.0398865Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:15.0399702Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:15.0400255Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:15.0400829Z fi
2026-11-07T06:33:15.0401011Z 
2026-11-07T06:33:15.0401495Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:15.0402325Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:15.0402741Z #case "$TERM" in
2026-11-07T06:33:15.0403040Z #xterm*|rxvt*)
2026-11-07T06:33:15.0403485Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:15.0403974Z #    ;;
2026-11-07T06:33:15.0404217Z #*)
2026-11-07T06:33:15.0404471Z #    ;;
2026-11-07T06:33:15.0404710Z #esac
2026-11-07T06:33:15.0404864Z 
2026-11-07T06:33:15.0405079Z # enable bash completion in interactive shells
2026-11-07T06:33:15.0405515Z #if ! shopt -oq posix; then
2026-11-07T06:33:15.0405988Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-07T06:33:15.0406540Z #    . /usr/share/bash-completion/bash_completion
2026-11-07T06:33:15.0406987Z #  elif [ -f /etc/bash_completion ]; then
