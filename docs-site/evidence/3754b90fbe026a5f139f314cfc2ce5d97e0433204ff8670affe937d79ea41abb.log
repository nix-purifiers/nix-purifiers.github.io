2026-11-06T03:00:49.6112400Z #  fi
2026-11-06T03:00:49.6112568Z #fi
2026-11-06T03:00:49.6112660Z 
2026-11-06T03:00:49.6112740Z # sudo hint
2026-11-06T03:00:49.6113063Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:00:49.6113487Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:00:49.6113776Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:00:49.6114018Z 	cat <<-EOF
2026-11-06T03:00:49.6114306Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:00:49.6114915Z 	See "man sudo_root" for details.
2026-11-06T03:00:49.6115168Z 	
2026-11-06T03:00:49.6115330Z 	EOF
2026-11-06T03:00:49.6115498Z     fi
2026-11-06T03:00:49.6115673Z     esac
2026-11-06T03:00:49.6115846Z fi
2026-11-06T03:00:49.6115938Z 
2026-11-06T03:00:49.6116225Z # if the command-not-found package is installed, use it
2026-11-06T03:00:49.6116729Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:49.6117184Z 	function command_not_found_handle {
2026-11-06T03:00:49.6117773Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:00:49.6118287Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:00:49.6118611Z 		   /usr/lib/command-not-found -- "$1"
