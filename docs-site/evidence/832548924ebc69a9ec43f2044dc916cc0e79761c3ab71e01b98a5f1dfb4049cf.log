2026-11-06T03:00:26.9946029Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:00:26.9946294Z 
2026-11-06T03:00:26.9946598Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:00:26.9947049Z # this file has to be sourced in /etc/profile.
2026-11-06T03:00:26.9947278Z 
2026-11-06T03:00:26.9947423Z # If not running interactively, don't do anything
2026-11-06T03:00:26.9947899Z [ -z "$PS1" ] && return
2026-11-06T03:00:26.9948101Z 
2026-11-06T03:00:26.9948298Z # check the window size after each command and, if necessary,
2026-11-06T03:00:26.9948747Z # update the values of LINES and COLUMNS.
2026-11-06T03:00:26.9949067Z shopt -s checkwinsize
2026-11-06T03:00:26.9949214Z 
2026-11-06T03:00:26.9949462Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:00:26.9950043Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:00:26.9950434Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:00:26.9950724Z fi
2026-11-06T03:00:26.9950894Z 
2026-11-06T03:00:26.9951324Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:00:26.9951859Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:00:26.9952388Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:00:26.9952761Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:00:26.9953069Z fi
2026-11-06T03:00:26.9953252Z 
2026-11-06T03:00:26.9953478Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:00:26.9953932Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:00:26.9954325Z #case "$TERM" in
2026-11-06T03:00:26.9954568Z #xterm*|rxvt*)
2026-11-06T03:00:26.9954927Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:00:26.9955346Z #    ;;
2026-11-06T03:00:26.9955565Z #*)
2026-11-06T03:00:26.9955872Z #    ;;
2026-11-06T03:00:26.9956100Z #esac
2026-11-06T03:00:26.9956228Z 
2026-11-06T03:00:26.9956368Z # enable bash completion in interactive shells
2026-11-06T03:00:26.9956744Z #if ! shopt -oq posix; then
2026-11-06T03:00:26.9957110Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:00:26.9957537Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:00:26.9957957Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:00:26.9958270Z #    . /etc/bash_completion
2026-11-06T03:00:26.9958562Z #  fi
2026-11-06T03:00:26.9958760Z #fi
2026-11-06T03:00:26.9958898Z 
2026-11-06T03:00:26.9958996Z # sudo hint
2026-11-06T03:00:26.9959390Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:00:26.9959834Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:00:26.9960189Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:00:26.9960472Z 	cat <<-EOF
2026-11-06T03:00:26.9961355Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:00:26.9961980Z 	See "man sudo_root" for details.
2026-11-06T03:00:26.9962268Z 	
2026-11-06T03:00:26.9962503Z 	EOF
2026-11-06T03:00:26.9962776Z     fi
2026-11-06T03:00:26.9963210Z     esac
2026-11-06T03:00:26.9963472Z fi
2026-11-06T03:00:26.9963600Z 
2026-11-06T03:00:26.9963770Z # if the command-not-found package is installed, use it
2026-11-06T03:00:26.9964303Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:26.9964906Z 	function command_not_found_handle {
2026-11-06T03:00:26.9965283Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:00:26.9965735Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:00:26.9966103Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:00:26.9966404Z                    return $?
2026-11-06T03:00:26.9966866Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:26.9967336Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:00:26.9967715Z                    return $?
2026-11-06T03:00:26.9967980Z 		else
2026-11-06T03:00:26.9968243Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:00:26.9968651Z 		   return 127
2026-11-06T03:00:26.9968869Z 		fi
