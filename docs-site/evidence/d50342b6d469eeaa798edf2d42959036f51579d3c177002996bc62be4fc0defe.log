2026-11-06T02:58:47.0195244Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:58:47.0195459Z 
2026-11-06T02:58:47.0195646Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:58:47.0195999Z # this file has to be sourced in /etc/profile.
2026-11-06T02:58:47.0196187Z 
2026-11-06T02:58:47.0196295Z # If not running interactively, don't do anything
2026-11-06T02:58:47.0196566Z [ -z "$PS1" ] && return
2026-11-06T02:58:47.0196687Z 
2026-11-06T02:58:47.0196826Z # check the window size after each command and, if necessary,
2026-11-06T02:58:47.0197132Z # update the values of LINES and COLUMNS.
2026-11-06T02:58:47.0197375Z shopt -s checkwinsize
2026-11-06T02:58:47.0197496Z 
2026-11-06T02:58:47.0197707Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:58:47.0198110Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:58:47.0198416Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:58:47.0198648Z fi
2026-11-06T02:58:47.0198738Z 
2026-11-06T02:58:47.0198890Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:58:47.0199275Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:58:47.0199651Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:58:47.0199937Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:58:47.0200180Z fi
2026-11-06T02:58:47.0200268Z 
2026-11-06T02:58:47.0200528Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:58:47.0200895Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:58:47.0201150Z #case "$TERM" in
2026-11-06T02:58:47.0201329Z #xterm*|rxvt*)
2026-11-06T02:58:47.0201595Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:58:47.0201898Z #    ;;
2026-11-06T02:58:47.0202052Z #*)
2026-11-06T02:58:47.0202211Z #    ;;
2026-11-06T02:58:47.0202367Z #esac
2026-11-06T02:58:47.0202454Z 
2026-11-06T02:58:47.0202566Z # enable bash completion in interactive shells
2026-11-06T02:58:47.0202839Z #if ! shopt -oq posix; then
2026-11-06T02:58:47.0203114Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:58:47.0203518Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:58:47.0203691Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T02:58:47.0203846Z #    . /etc/bash_completion
2026-11-06T02:58:47.0203977Z #  fi
2026-11-06T02:58:47.0204077Z #fi
2026-11-06T02:58:47.0204132Z 
2026-11-06T02:58:47.0204179Z # sudo hint
2026-11-06T02:58:47.0204360Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:58:47.0204589Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:58:47.0204757Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:58:47.0204899Z 	cat <<-EOF
2026-11-06T02:58:47.0205260Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:58:47.0205462Z 	See "man sudo_root" for details.
2026-11-06T02:58:47.0205598Z 	
2026-11-06T02:58:47.0205697Z 	EOF
2026-11-06T02:58:47.0205797Z     fi
2026-11-06T02:58:47.0206003Z     esac
2026-11-06T02:58:47.0206101Z fi
2026-11-06T02:58:47.0206155Z 
2026-11-06T02:58:47.0206242Z # if the command-not-found package is installed, use it
2026-11-06T02:58:47.0206512Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:58:47.0206762Z 	function command_not_found_handle {
2026-11-06T02:58:47.0206949Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:58:47.0207156Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:58:47.0207328Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:58:47.0207479Z                    return $?
2026-11-06T02:58:47.0207658Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:58:47.0207887Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:58:47.0208062Z                    return $?
2026-11-06T02:58:47.0208182Z 		else
2026-11-06T02:58:47.0208303Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:58:47.0208456Z 		   return 127
2026-11-06T02:58:47.0208561Z 		fi
