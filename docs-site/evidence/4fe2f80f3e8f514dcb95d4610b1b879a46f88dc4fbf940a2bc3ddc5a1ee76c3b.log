2026-11-13T10:02:16.3532107Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-13T10:02:16.3532424Z 
2026-11-13T10:02:16.3532636Z # To enable the settings / commands in this file for login shells as well,
2026-11-13T10:02:16.3533058Z # this file has to be sourced in /etc/profile.
2026-11-13T10:02:16.3533316Z 
2026-11-13T10:02:16.3533452Z # If not running interactively, don't do anything
2026-11-13T10:02:16.3533772Z [ -z "$PS1" ] && return
2026-11-13T10:02:16.3533963Z 
2026-11-13T10:02:16.3534110Z # check the window size after each command and, if necessary,
2026-11-13T10:02:16.3534521Z # update the values of LINES and COLUMNS.
2026-11-13T10:02:16.3534831Z shopt -s checkwinsize
2026-11-13T10:02:16.3534959Z 
2026-11-13T10:02:16.3535223Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-13T10:02:16.3535696Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-13T10:02:16.3536085Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-13T10:02:16.3536442Z fi
2026-11-13T10:02:16.3536558Z 
2026-11-13T10:02:16.3536731Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-13T10:02:16.3537216Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-13T10:02:16.3537639Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-13T10:02:16.3538033Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-13T10:02:16.3538368Z fi
2026-11-13T10:02:16.3538465Z 
2026-11-13T10:02:16.3538939Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-13T10:02:16.3539653Z # If this is an xterm set the title to user@host:dir
2026-11-13T10:02:16.3539989Z #case "$TERM" in
2026-11-13T10:02:16.3540254Z #xterm*|rxvt*)
2026-11-13T10:02:16.3540627Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-13T10:02:16.3540985Z #    ;;
2026-11-13T10:02:16.3541270Z #*)
2026-11-13T10:02:16.3541471Z #    ;;
2026-11-13T10:02:16.3541698Z #esac
2026-11-13T10:02:16.3541791Z 
2026-11-13T10:02:16.3541971Z # enable bash completion in interactive shells
2026-11-13T10:02:16.3542316Z #if ! shopt -oq posix; then
2026-11-13T10:02:16.3543084Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-13T10:02:16.3543605Z #    . /usr/share/bash-completion/bash_completion
2026-11-13T10:02:16.3543976Z #  elif [ -f /etc/bash_completion ]; then
2026-11-13T10:02:16.3544381Z #    . /etc/bash_completion
2026-11-13T10:02:16.3544627Z #  fi
2026-11-13T10:02:16.3544831Z #fi
2026-11-13T10:02:16.3544969Z 
2026-11-13T10:02:16.3545110Z # sudo hint
2026-11-13T10:02:16.3545441Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-13T10:02:16.3545887Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-13T10:02:16.3546549Z     if [ -x /usr/bin/sudo ]; then
2026-11-13T10:02:16.3546839Z 	cat <<-EOF
2026-11-13T10:02:16.3547223Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-13T10:02:16.3547609Z 	See "man sudo_root" for details.
2026-11-13T10:02:16.3547863Z 	
2026-11-13T10:02:16.3548113Z 	EOF
2026-11-13T10:02:16.3548486Z     fi
2026-11-13T10:02:16.3548754Z     esac
2026-11-13T10:02:16.3548947Z fi
2026-11-13T10:02:16.3549045Z 
2026-11-13T10:02:16.3549553Z # if the command-not-found package is installed, use it
2026-11-13T10:02:16.3550148Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-13T10:02:16.3550621Z 	function command_not_found_handle {
2026-11-13T10:02:16.3551042Z 	        # check because c-n-f could've been removed in the meantime
2026-11-13T10:02:16.3551444Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-13T10:02:16.3551791Z 		   /usr/lib/command-not-found -- "$1"
2026-11-13T10:02:16.3552112Z                    return $?
2026-11-13T10:02:16.3552463Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-13T10:02:16.3552958Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-13T10:02:16.3553303Z                    return $?
2026-11-13T10:02:16.3553542Z 		else
2026-11-13T10:02:16.3553808Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-13T10:02:16.3554105Z 		   return 127
2026-11-13T10:02:16.3554337Z 		fi
