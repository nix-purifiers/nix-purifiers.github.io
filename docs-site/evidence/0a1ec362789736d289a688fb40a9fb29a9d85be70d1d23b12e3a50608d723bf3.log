2026-11-07T11:51:11.4143908Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T11:51:11.4144358Z 
2026-11-07T11:51:11.4144707Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T11:51:11.4145437Z # this file has to be sourced in /etc/profile.
2026-11-07T11:51:11.4145801Z 
2026-11-07T11:51:11.4146019Z # If not running interactively, don't do anything
2026-11-07T11:51:11.4146567Z [ -z "$PS1" ] && return
2026-11-07T11:51:11.4147084Z 
2026-11-07T11:51:11.4147358Z # check the window size after each command and, if necessary,
2026-11-07T11:51:11.4147975Z # update the values of LINES and COLUMNS.
2026-11-07T11:51:11.4148469Z shopt -s checkwinsize
2026-11-07T11:51:11.4148699Z 
2026-11-07T11:51:11.4149075Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T11:51:11.4149873Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T11:51:11.4150481Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T11:51:11.4150938Z fi
2026-11-07T11:51:11.4151117Z 
2026-11-07T11:51:11.4151418Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T11:51:11.4152191Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T11:51:11.4152832Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T11:51:11.4153203Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T11:51:11.4153518Z fi
2026-11-07T11:51:11.4153615Z 
2026-11-07T11:51:11.4153819Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T11:51:11.4154250Z # If this is an xterm set the title to user@host:dir
2026-11-07T11:51:11.4154575Z #case "$TERM" in
2026-11-07T11:51:11.4154792Z #xterm*|rxvt*)
2026-11-07T11:51:11.4155339Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T11:51:11.4155940Z #    ;;
2026-11-07T11:51:11.4156232Z #*)
2026-11-07T11:51:11.4156539Z #    ;;
2026-11-07T11:51:11.4157082Z #esac
2026-11-07T11:51:11.4157265Z 
2026-11-07T11:51:11.4157477Z # enable bash completion in interactive shells
