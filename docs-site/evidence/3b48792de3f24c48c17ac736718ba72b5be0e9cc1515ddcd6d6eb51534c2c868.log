2026-11-06T02:57:38.3605635Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:57:38.3605957Z 
2026-11-06T02:57:38.3606226Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:57:38.3610986Z # this file has to be sourced in /etc/profile.
2026-11-06T02:57:38.3611449Z 
2026-11-06T02:57:38.3611622Z # If not running interactively, don't do anything
2026-11-06T02:57:38.3611947Z [ -z "$PS1" ] && return
2026-11-06T02:57:38.3612085Z 
2026-11-06T02:57:38.3612305Z # check the window size after each command and, if necessary,
2026-11-06T02:57:38.3612757Z # update the values of LINES and COLUMNS.
2026-11-06T02:57:38.3613047Z shopt -s checkwinsize
2026-11-06T02:57:38.3613240Z 
2026-11-06T02:57:38.3613460Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:57:38.3614046Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:57:38.3614406Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:57:38.3614810Z fi
2026-11-06T02:57:38.3614906Z 
2026-11-06T02:57:38.3615097Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:57:38.3615604Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:57:38.3616019Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:57:38.3616362Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:57:38.3616747Z fi
2026-11-06T02:57:38.3617179Z 
2026-11-06T02:57:38.3617582Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:57:38.3618085Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:57:38.3618424Z #case "$TERM" in
2026-11-06T02:57:38.3618644Z #xterm*|rxvt*)
2026-11-06T02:57:38.3619046Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:57:38.3619414Z #    ;;
2026-11-06T02:57:38.3619629Z #*)
2026-11-06T02:57:38.3619823Z #    ;;
2026-11-06T02:57:38.3620011Z #esac
2026-11-06T02:57:38.3620180Z 
2026-11-06T02:57:38.3620309Z # enable bash completion in interactive shells
2026-11-06T02:57:38.3620629Z #if ! shopt -oq posix; then
2026-11-06T02:57:38.3620947Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:57:38.3621365Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:57:38.3621723Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T02:57:38.3622082Z #    . /etc/bash_completion
2026-11-06T02:57:38.3622315Z #  fi
2026-11-06T02:57:38.3622494Z #fi
2026-11-06T02:57:38.3622641Z 
2026-11-06T02:57:38.3622719Z # sudo hint
2026-11-06T02:57:38.3623038Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:57:38.3623525Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:57:38.3623831Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:57:38.3624075Z 	cat <<-EOF
2026-11-06T02:57:38.3624665Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:57:38.3625108Z 	See "man sudo_root" for details.
2026-11-06T02:57:38.3625408Z 	
2026-11-06T02:57:38.3625597Z 	EOF
2026-11-06T02:57:38.3625781Z     fi
2026-11-06T02:57:38.3626134Z     esac
2026-11-06T02:57:38.3626359Z fi
2026-11-06T02:57:38.3626471Z 
2026-11-06T02:57:38.3626657Z # if the command-not-found package is installed, use it
2026-11-06T02:57:38.3627396Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:57:38.3627862Z 	function command_not_found_handle {
2026-11-06T02:57:38.3628261Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:57:38.3628680Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:57:38.3628995Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:57:38.3629312Z                    return $?
2026-11-06T02:57:38.3629651Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:57:38.3630123Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:57:38.3630516Z                    return $?
2026-11-06T02:57:38.3630742Z 		else
2026-11-06T02:57:38.3630998Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:57:38.3631291Z 		   return 127
2026-11-06T02:57:38.3631508Z 		fi
2026-11-06T02:57:38.3631736Z 	}
