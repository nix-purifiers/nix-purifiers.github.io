2026-11-12T03:36:34.9445476Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-12T03:36:34.9445729Z 
2026-11-12T03:36:34.9445985Z # To enable the settings / commands in this file for login shells as well,
2026-11-12T03:36:34.9446459Z # this file has to be sourced in /etc/profile.
2026-11-12T03:36:34.9446678Z 
2026-11-12T03:36:34.9446891Z # If not running interactively, don't do anything
2026-11-12T03:36:34.9447330Z [ -z "$PS1" ] && return
2026-11-12T03:36:34.9447526Z 
2026-11-12T03:36:34.9447747Z # check the window size after each command and, if necessary,
2026-11-12T03:36:34.9448175Z # update the values of LINES and COLUMNS.
2026-11-12T03:36:34.9448542Z shopt -s checkwinsize
2026-11-12T03:36:34.9448702Z 
2026-11-12T03:36:34.9449493Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-12T03:36:34.9450132Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-12T03:36:34.9450690Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-12T03:36:34.9451090Z fi
2026-11-12T03:36:34.9451329Z 
2026-11-12T03:36:34.9451566Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-12T03:36:34.9452264Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-12T03:36:34.9453074Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-12T03:36:34.9453716Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-12T03:36:34.9454072Z fi
2026-11-12T03:36:34.9454231Z 
2026-11-12T03:36:34.9454503Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-12T03:36:34.9455015Z # If this is an xterm set the title to user@host:dir
2026-11-12T03:36:34.9455392Z #case "$TERM" in
2026-11-12T03:36:34.9455701Z #xterm*|rxvt*)
2026-11-12T03:36:34.9456097Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-12T03:36:34.9456569Z #    ;;
2026-11-12T03:36:34.9456865Z #*)
2026-11-12T03:36:34.9457150Z #    ;;
2026-11-12T03:36:34.9457432Z #esac
2026-11-12T03:36:34.9457563Z 
