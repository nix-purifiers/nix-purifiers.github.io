2026-11-07T06:33:14.4029863Z #  fi
2026-11-07T06:33:14.4030074Z #fi
2026-11-07T06:33:14.4030189Z 
2026-11-07T06:33:14.4030288Z # sudo hint
2026-11-07T06:33:14.4030720Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:14.4031414Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T06:33:14.4031785Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T06:33:14.4031998Z 	cat <<-EOF
2026-11-07T06:33:14.4032232Z 	To run a command as administrator (user "root"), use "sudo <command>".
