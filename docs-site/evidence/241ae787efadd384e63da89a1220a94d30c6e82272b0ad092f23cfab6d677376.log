2026-11-07T11:51:13.3487300Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-07T11:51:13.3487671Z #    . /usr/share/bash-completion/bash_completion
2026-11-07T11:51:13.3488042Z #  elif [ -f /etc/bash_completion ]; then
