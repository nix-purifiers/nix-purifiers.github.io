2026-11-12T00:55:12.0455101Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-12T00:55:12.0455528Z 
2026-11-12T00:55:12.0455862Z # To enable the settings / commands in this file for login shells as well,
2026-11-12T00:55:12.0456595Z # this file has to be sourced in /etc/profile.
2026-11-12T00:55:12.0456898Z 
2026-11-12T00:55:12.0457037Z # If not running interactively, don't do anything
2026-11-12T00:55:12.0457402Z [ -z "$PS1" ] && return
2026-11-12T00:55:12.0457587Z 
2026-11-12T00:55:12.0457760Z # check the window size after each command and, if necessary,
2026-11-12T00:55:12.0458212Z # update the values of LINES and COLUMNS.
2026-11-12T00:55:12.0458537Z shopt -s checkwinsize
2026-11-12T00:55:12.0458682Z 
2026-11-12T00:55:12.0458943Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-12T00:55:12.0459479Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-12T00:55:12.0460279Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-12T00:55:12.0460626Z fi
2026-11-12T00:55:12.0460738Z 
2026-11-12T00:55:12.0460947Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-12T00:55:12.0461448Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-12T00:55:12.0461924Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-12T00:55:12.0462296Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-12T00:55:12.0462613Z fi
2026-11-12T00:55:12.0462721Z 
2026-11-12T00:55:12.0462944Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-12T00:55:12.0463414Z # If this is an xterm set the title to user@host:dir
2026-11-12T00:55:12.0463742Z #case "$TERM" in
2026-11-12T00:55:12.0463964Z #xterm*|rxvt*)
2026-11-12T00:55:12.0464839Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-12T00:55:12.0465255Z #    ;;
2026-11-12T00:55:12.0465451Z #*)
2026-11-12T00:55:12.0465642Z #    ;;
2026-11-12T00:55:12.0465827Z #esac
2026-11-12T00:55:12.0465935Z 
