2026-11-07T11:51:12.3953813Z 
2026-11-07T11:51:12.3953936Z # if the command-not-found package is installed, use it
2026-11-07T11:51:12.3954325Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:12.3954674Z 	function command_not_found_handle {
2026-11-07T11:51:12.3954937Z 	        # check because c-n-f could've been removed in the meantime
2026-11-07T11:51:12.3955229Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-07T11:51:12.3955474Z 		   /usr/lib/command-not-found -- "$1"
2026-11-07T11:51:12.3955695Z                    return $?
2026-11-07T11:51:12.3955959Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:12.3956291Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-07T11:51:12.3956542Z                    return $?
2026-11-07T11:51:12.3956715Z 		else
