2026-11-06T03:19:04.1655313Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:19:04.1655438Z 
2026-11-06T03:19:04.1655550Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:19:04.1655795Z # this file has to be sourced in /etc/profile.
2026-11-06T03:19:04.1655957Z 
2026-11-06T03:19:04.1656060Z # If not running interactively, don't do anything
2026-11-06T03:19:04.1656292Z [ -z "$PS1" ] && return
2026-11-06T03:19:04.1656369Z 
2026-11-06T03:19:04.1656453Z # check the window size after each command and, if necessary,
2026-11-06T03:19:04.1656637Z # update the values of LINES and COLUMNS.
2026-11-06T03:19:04.1656785Z shopt -s checkwinsize
2026-11-06T03:19:04.1656858Z 
2026-11-06T03:19:04.1656969Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:19:04.1657207Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:19:04.1657394Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:19:04.1657533Z fi
2026-11-06T03:19:04.1657587Z 
2026-11-06T03:19:04.1657680Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:19:04.1657938Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:19:04.1658178Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:19:04.1658357Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:19:04.1658507Z fi
2026-11-06T03:19:04.1658559Z 
2026-11-06T03:19:04.1658666Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:19:04.1658888Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:19:04.1659043Z #case "$TERM" in
2026-11-06T03:19:04.1659154Z #xterm*|rxvt*)
2026-11-06T03:19:04.1659317Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:19:04.1659503Z #    ;;
2026-11-06T03:19:04.1659598Z #*)
2026-11-06T03:19:04.1659692Z #    ;;
2026-11-06T03:19:04.1659789Z #esac
2026-11-06T03:19:04.1659844Z 
2026-11-06T03:19:04.1659914Z # enable bash completion in interactive shells
2026-11-06T03:19:04.1660086Z #if ! shopt -oq posix; then
2026-11-06T03:19:04.1660252Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:19:04.1660439Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:19:04.1660604Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:19:04.1660749Z #    . /etc/bash_completion
2026-11-06T03:19:04.1660867Z #  fi
2026-11-06T03:19:04.1660959Z #fi
2026-11-06T03:19:04.1661014Z 
2026-11-06T03:19:04.1661056Z # sudo hint
2026-11-06T03:19:04.1661223Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:19:04.1661438Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:19:04.1661595Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:19:04.1661726Z 	cat <<-EOF
2026-11-06T03:19:04.1661881Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:19:04.1662267Z 	See "man sudo_root" for details.
2026-11-06T03:19:04.1662394Z 	
2026-11-06T03:19:04.1662485Z 	EOF
2026-11-06T03:19:04.1662578Z     fi
2026-11-06T03:19:04.1662771Z     esac
2026-11-06T03:19:04.1662864Z fi
2026-11-06T03:19:04.1662918Z 
2026-11-06T03:19:04.1663001Z # if the command-not-found package is installed, use it
2026-11-06T03:19:04.1663263Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:19:04.1663498Z 	function command_not_found_handle {
2026-11-06T03:19:04.1663674Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:19:04.1663871Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:19:04.1664035Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:19:04.1664317Z                    return $?
2026-11-06T03:19:04.1664598Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:19:04.1664883Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:19:04.1665093Z                    return $?
2026-11-06T03:19:04.1665211Z 		else
2026-11-06T03:19:04.1665325Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:19:04.1665474Z 		   return 127
