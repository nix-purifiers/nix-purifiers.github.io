2026-11-06T03:01:35.9613194Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:01:35.9613650Z 
2026-11-06T03:01:35.9614000Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:01:35.9614724Z # this file has to be sourced in /etc/profile.
2026-11-06T03:01:35.9615100Z 
2026-11-06T03:01:35.9615314Z # If not running interactively, don't do anything
2026-11-06T03:01:35.9615842Z [ -z "$PS1" ] && return
2026-11-06T03:01:35.9616118Z 
2026-11-06T03:01:35.9616398Z # check the window size after each command and, if necessary,
2026-11-06T03:01:35.9617010Z # update the values of LINES and COLUMNS.
2026-11-06T03:01:35.9617536Z shopt -s checkwinsize
2026-11-06T03:01:35.9617767Z 
2026-11-06T03:01:35.9618150Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:01:35.9618975Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:01:35.9619576Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:01:35.9620026Z fi
2026-11-06T03:01:35.9620198Z 
2026-11-06T03:01:35.9620495Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:01:35.9621515Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:01:35.9622151Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:01:35.9622504Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:01:35.9622815Z fi
2026-11-06T03:01:35.9622906Z 
2026-11-06T03:01:35.9623123Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:01:35.9623545Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:01:35.9623859Z #case "$TERM" in
2026-11-06T03:01:35.9624058Z #xterm*|rxvt*)
2026-11-06T03:01:35.9624543Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:01:35.9625152Z #    ;;
2026-11-06T03:01:35.9625456Z #*)
2026-11-06T03:01:35.9625753Z #    ;;
2026-11-06T03:01:35.9626044Z #esac
2026-11-06T03:01:35.9626211Z 
2026-11-06T03:01:35.9626478Z # enable bash completion in interactive shells
2026-11-06T03:01:35.9627243Z #if ! shopt -oq posix; then
2026-11-06T03:01:35.9627593Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:01:35.9627961Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:01:35.9628285Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:01:35.9628559Z #    . /etc/bash_completion
2026-11-06T03:01:35.9628778Z #  fi
2026-11-06T03:01:35.9628946Z #fi
2026-11-06T03:01:35.9629047Z 
2026-11-06T03:01:35.9629120Z # sudo hint
2026-11-06T03:01:35.9629446Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:01:35.9629853Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:01:35.9630140Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:01:35.9630813Z 	cat <<-EOF
2026-11-06T03:01:35.9631149Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:01:35.9631524Z 	See "man sudo_root" for details.
2026-11-06T03:01:35.9631751Z 	
2026-11-06T03:01:35.9632063Z 	EOF
2026-11-06T03:01:35.9632225Z     fi
2026-11-06T03:01:35.9632394Z     esac
2026-11-06T03:01:35.9632559Z fi
2026-11-06T03:01:35.9632653Z 
2026-11-06T03:01:35.9632797Z # if the command-not-found package is installed, use it
2026-11-06T03:01:35.9633286Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:01:35.9633731Z 	function command_not_found_handle {
2026-11-06T03:01:35.9634054Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:01:35.9634433Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:01:35.9634746Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:01:35.9635008Z                    return $?
2026-11-06T03:01:35.9635336Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:01:35.9635745Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:01:35.9636064Z                    return $?
2026-11-06T03:01:35.9636285Z 		else
2026-11-06T03:01:35.9636492Z 		   printf "%s: command not found\n" "$1" >&2
