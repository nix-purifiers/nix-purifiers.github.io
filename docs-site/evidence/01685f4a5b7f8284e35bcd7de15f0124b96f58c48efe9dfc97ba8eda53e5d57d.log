2026-11-06T03:02:10.9176352Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:02:10.9176676Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:02:10.9176955Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:02:10.9177207Z #    . /etc/bash_completion
2026-11-06T03:02:10.9177409Z #  fi
