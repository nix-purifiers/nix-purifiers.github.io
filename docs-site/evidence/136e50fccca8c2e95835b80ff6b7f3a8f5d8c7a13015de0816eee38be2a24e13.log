2026-11-06T03:09:03.0228479Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:09:03.0228774Z 
2026-11-06T03:09:03.0228971Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:09:03.0229483Z # this file has to be sourced in /etc/profile.
2026-11-06T03:09:03.0229720Z 
2026-11-06T03:09:03.0229907Z # If not running interactively, don't do anything
2026-11-06T03:09:03.0230235Z [ -z "$PS1" ] && return
2026-11-06T03:09:03.0230368Z 
2026-11-06T03:09:03.0230576Z # check the window size after each command and, if necessary,
2026-11-06T03:09:03.0230976Z # update the values of LINES and COLUMNS.
2026-11-06T03:09:03.0231269Z shopt -s checkwinsize
2026-11-06T03:09:03.0231422Z 
2026-11-06T03:09:03.0231618Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:09:03.0232133Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:09:03.0232530Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:09:03.0232858Z fi
2026-11-06T03:09:03.0232956Z 
2026-11-06T03:09:03.0233145Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:09:03.0233582Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:09:03.0234068Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:09:03.0234447Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:09:03.0235075Z fi
2026-11-06T03:09:03.0235228Z 
2026-11-06T03:09:03.0235425Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:09:03.0235849Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:09:03.0236217Z #case "$TERM" in
2026-11-06T03:09:03.0236471Z #xterm*|rxvt*)
2026-11-06T03:09:03.0236805Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:09:03.0237182Z #    ;;
2026-11-06T03:09:03.0237372Z #*)
2026-11-06T03:09:03.0237590Z #    ;;
2026-11-06T03:09:03.0237821Z #esac
2026-11-06T03:09:03.0237939Z 
2026-11-06T03:09:03.0238048Z # enable bash completion in interactive shells
2026-11-06T03:09:03.0238417Z #if ! shopt -oq posix; then
2026-11-06T03:09:03.0238730Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:09:03.0239163Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:09:03.0239523Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:09:03.0239802Z #    . /etc/bash_completion
2026-11-06T03:09:03.0240072Z #  fi
2026-11-06T03:09:03.0240264Z #fi
2026-11-06T03:09:03.0240370Z 
2026-11-06T03:09:03.0240474Z # sudo hint
2026-11-06T03:09:03.0240845Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:09:03.0241261Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:09:03.0241620Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:09:03.0241881Z 	cat <<-EOF
2026-11-06T03:09:03.0242470Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:09:03.0242951Z 	See "man sudo_root" for details.
2026-11-06T03:09:03.0243208Z 	
2026-11-06T03:09:03.0243431Z 	EOF
2026-11-06T03:09:03.0243624Z     fi
2026-11-06T03:09:03.0243809Z     esac
2026-11-06T03:09:03.0244309Z fi
2026-11-06T03:09:03.0244442Z 
2026-11-06T03:09:03.0244790Z # if the command-not-found package is installed, use it
2026-11-06T03:09:03.0245422Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:09:03.0245906Z 	function command_not_found_handle {
2026-11-06T03:09:03.0246276Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:09:03.0246732Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:09:03.0247063Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:09:03.0247369Z                    return $?
2026-11-06T03:09:03.0247722Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:09:03.0248184Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:09:03.0248567Z                    return $?
2026-11-06T03:09:03.0248801Z 		else
2026-11-06T03:09:03.0249043Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:09:03.0249347Z 		   return 127
2026-11-06T03:09:03.0249591Z 		fi
2026-11-06T03:09:03.0249808Z 	}
