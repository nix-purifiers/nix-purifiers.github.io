2026-11-06T03:09:02.5422023Z 
2026-11-06T03:09:02.5422138Z # sudo hint
2026-11-06T03:09:02.5422596Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:09:02.5423128Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:09:02.5423517Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:09:02.5423874Z 	cat <<-EOF
2026-11-06T03:09:02.5424255Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:09:02.5424994Z 	See "man sudo_root" for details.
2026-11-06T03:09:02.5425364Z 	
2026-11-06T03:09:02.5425634Z 	EOF
2026-11-06T03:09:02.5425912Z     fi
2026-11-06T03:09:02.5426210Z     esac
2026-11-06T03:09:02.5426532Z fi
2026-11-06T03:09:02.5426688Z 
2026-11-06T03:09:02.5426916Z # if the command-not-found package is installed, use it
2026-11-06T03:09:02.5427748Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:09:02.5428491Z 	function command_not_found_handle {
2026-11-06T03:09:02.5429090Z 	        # check because c-n-f could've been removed in the meantime
