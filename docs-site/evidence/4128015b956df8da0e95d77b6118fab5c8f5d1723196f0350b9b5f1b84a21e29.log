2026-11-06T03:19:01.8144072Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:19:01.8144379Z 
2026-11-06T03:19:01.8144640Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:19:01.8145065Z # this file has to be sourced in /etc/profile.
2026-11-06T03:19:01.8145279Z 
2026-11-06T03:19:01.8145425Z # If not running interactively, don't do anything
2026-11-06T03:19:01.8145735Z [ -z "$PS1" ] && return
2026-11-06T03:19:01.8145879Z 
2026-11-06T03:19:01.8146192Z # check the window size after each command and, if necessary,
2026-11-06T03:19:01.8146626Z # update the values of LINES and COLUMNS.
2026-11-06T03:19:01.8146864Z shopt -s checkwinsize
2026-11-06T03:19:01.8146999Z 
2026-11-06T03:19:01.8147206Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:19:01.8147597Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:19:01.8147907Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:19:01.8148144Z fi
2026-11-06T03:19:01.8148230Z 
2026-11-06T03:19:01.8148392Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:19:01.8148754Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:19:01.8149146Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:19:01.8149445Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:19:01.8149686Z fi
2026-11-06T03:19:01.8149780Z 
2026-11-06T03:19:01.8149953Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:19:01.8150450Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:19:01.8150866Z #case "$TERM" in
2026-11-06T03:19:01.8151173Z #xterm*|rxvt*)
2026-11-06T03:19:01.8151578Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:19:01.8152048Z #    ;;
2026-11-06T03:19:01.8152302Z #*)
2026-11-06T03:19:01.8152537Z #    ;;
2026-11-06T03:19:01.8152809Z #esac
2026-11-06T03:19:01.8152947Z 
