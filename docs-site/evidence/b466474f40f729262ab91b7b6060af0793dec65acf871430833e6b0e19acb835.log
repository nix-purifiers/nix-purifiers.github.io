2026-11-06T02:59:25.2773204Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:59:25.2773427Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:59:25.2773587Z #  elif [ -f /etc/bash_completion ]; then
