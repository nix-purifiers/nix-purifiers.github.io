2026-11-06T02:58:54.3380606Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:58:54.3380891Z 
2026-11-06T02:58:54.3381117Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:58:54.3381538Z # this file has to be sourced in /etc/profile.
2026-11-06T02:58:54.3381851Z 
2026-11-06T02:58:54.3381975Z # If not running interactively, don't do anything
2026-11-06T02:58:54.3382291Z [ -z "$PS1" ] && return
2026-11-06T02:58:54.3382440Z 
2026-11-06T02:58:54.3382626Z # check the window size after each command and, if necessary,
2026-11-06T02:58:54.3383015Z # update the values of LINES and COLUMNS.
2026-11-06T02:58:54.3383300Z shopt -s checkwinsize
2026-11-06T02:58:54.3383495Z 
2026-11-06T02:58:54.3383770Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:58:54.3384356Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:58:54.3384749Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:58:54.3385040Z fi
2026-11-06T02:58:54.3385154Z 
2026-11-06T02:58:54.3385332Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:58:54.3385862Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:58:54.3386291Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:58:54.3386649Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:58:54.3386960Z fi
2026-11-06T02:58:54.3387055Z 
2026-11-06T02:58:54.3387270Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:58:54.3387753Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:58:54.3388062Z #case "$TERM" in
2026-11-06T02:58:54.3388277Z #xterm*|rxvt*)
2026-11-06T02:58:54.3388622Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:58:54.3389023Z #    ;;
2026-11-06T02:58:54.3389314Z #*)
2026-11-06T02:58:54.3389501Z #    ;;
2026-11-06T02:58:54.3389684Z #esac
2026-11-06T02:58:54.3389805Z 
2026-11-06T02:58:54.3389950Z # enable bash completion in interactive shells
2026-11-06T02:58:54.3390501Z #if ! shopt -oq posix; then
2026-11-06T02:58:54.3391049Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:58:54.3391434Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:58:54.3391757Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T02:58:54.3392076Z #    . /etc/bash_completion
2026-11-06T02:58:54.3392327Z #  fi
2026-11-06T02:58:54.3392575Z #fi
2026-11-06T02:58:54.3392681Z 
2026-11-06T02:58:54.3392779Z # sudo hint
2026-11-06T02:58:54.3393102Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:58:54.3393546Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:58:54.3393852Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:58:54.3394141Z 	cat <<-EOF
2026-11-06T02:58:54.3394876Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:58:54.3395300Z 	See "man sudo_root" for details.
2026-11-06T02:58:54.3395632Z 	
2026-11-06T02:58:54.3395869Z 	EOF
2026-11-06T02:58:54.3396051Z     fi
2026-11-06T02:58:54.3396492Z     esac
2026-11-06T02:58:54.3396692Z fi
2026-11-06T02:58:54.3396792Z 
2026-11-06T02:58:54.3396983Z # if the command-not-found package is installed, use it
2026-11-06T02:58:54.3397530Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:58:54.3397993Z 	function command_not_found_handle {
2026-11-06T02:58:54.3398363Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:58:54.3398769Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:58:54.3399111Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:58:54.3399434Z                    return $?
2026-11-06T02:58:54.3399785Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:58:54.3400621Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:58:54.3400991Z                    return $?
2026-11-06T02:58:54.3401218Z 		else
2026-11-06T02:58:54.3401550Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:58:54.3401878Z 		   return 127
