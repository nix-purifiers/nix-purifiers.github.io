2026-11-06T03:19:01.8154960Z 
2026-11-06T03:19:01.8155051Z # sudo hint
2026-11-06T03:19:01.8155341Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:19:01.8155690Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:19:01.8155941Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:19:01.8156350Z 	cat <<-EOF
2026-11-06T03:19:01.8156615Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:19:01.8157190Z 	See "man sudo_root" for details.
2026-11-06T03:19:01.8157411Z 	
2026-11-06T03:19:01.8157582Z 	EOF
2026-11-06T03:19:01.8157756Z     fi
