2026-11-07T11:51:12.3939538Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T11:51:12.3939834Z 
2026-11-07T11:51:12.3940083Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T11:51:12.3940582Z # this file has to be sourced in /etc/profile.
2026-11-07T11:51:12.3940834Z 
2026-11-07T11:51:12.3940979Z # If not running interactively, don't do anything
2026-11-07T11:51:12.3941350Z [ -z "$PS1" ] && return
2026-11-07T11:51:12.3941528Z 
2026-11-07T11:51:12.3941710Z # check the window size after each command and, if necessary,
2026-11-07T11:51:12.3942129Z # update the values of LINES and COLUMNS.
2026-11-07T11:51:12.3942478Z shopt -s checkwinsize
2026-11-07T11:51:12.3942643Z 
2026-11-07T11:51:12.3943084Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T11:51:12.3943674Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T11:51:12.3944114Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T11:51:12.3944443Z fi
2026-11-07T11:51:12.3944562Z 
2026-11-07T11:51:12.3944771Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T11:51:12.3945337Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T11:51:12.3945857Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T11:51:12.3946267Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T11:51:12.3946615Z fi
2026-11-07T11:51:12.3946693Z 
2026-11-07T11:51:12.3946894Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T11:51:12.3947242Z # If this is an xterm set the title to user@host:dir
2026-11-07T11:51:12.3947477Z #case "$TERM" in
2026-11-07T11:51:12.3947648Z #xterm*|rxvt*)
2026-11-07T11:51:12.3947927Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T11:51:12.3948232Z #    ;;
2026-11-07T11:51:12.3948379Z #*)
2026-11-07T11:51:12.3948529Z #    ;;
2026-11-07T11:51:12.3948683Z #esac
2026-11-07T11:51:12.3948760Z 
