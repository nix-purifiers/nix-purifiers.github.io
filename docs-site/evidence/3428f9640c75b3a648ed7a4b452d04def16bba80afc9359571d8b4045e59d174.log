2026-11-06T03:02:15.2008606Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:02:15.2008993Z 
2026-11-06T03:02:15.2009280Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:02:15.2009913Z # this file has to be sourced in /etc/profile.
2026-11-06T03:02:15.2010125Z 
2026-11-06T03:02:15.2010259Z # If not running interactively, don't do anything
2026-11-06T03:02:15.2010562Z [ -z "$PS1" ] && return
2026-11-06T03:02:15.2010701Z 
2026-11-06T03:02:15.2010864Z # check the window size after each command and, if necessary,
2026-11-06T03:02:15.2011213Z # update the values of LINES and COLUMNS.
2026-11-06T03:02:15.2011486Z shopt -s checkwinsize
2026-11-06T03:02:15.2011627Z 
2026-11-06T03:02:15.2011831Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:02:15.2012282Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:02:15.2012651Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:02:15.2012935Z fi
2026-11-06T03:02:15.2013036Z 
2026-11-06T03:02:15.2013222Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:02:15.2013672Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:02:15.2014106Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:02:15.2014453Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:02:15.2014737Z fi
2026-11-06T03:02:15.2014841Z 
2026-11-06T03:02:15.2015038Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:02:15.2015484Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:02:15.2015769Z #case "$TERM" in
2026-11-06T03:02:15.2015981Z #xterm*|rxvt*)
2026-11-06T03:02:15.2016284Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:02:15.2016627Z #    ;;
2026-11-06T03:02:15.2016803Z #*)
2026-11-06T03:02:15.2016991Z #    ;;
2026-11-06T03:02:15.2017165Z #esac
2026-11-06T03:02:15.2017276Z 
2026-11-06T03:02:15.2017399Z # enable bash completion in interactive shells
2026-11-06T03:02:15.2017718Z #if ! shopt -oq posix; then
2026-11-06T03:02:15.2018081Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:02:15.2018614Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:02:15.2019076Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:02:15.2019631Z #    . /etc/bash_completion
2026-11-06T03:02:15.2019975Z #  fi
2026-11-06T03:02:15.2020236Z #fi
2026-11-06T03:02:15.2020391Z 
2026-11-06T03:02:15.2020509Z # sudo hint
2026-11-06T03:02:15.2021103Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:02:15.2021844Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:02:15.2022145Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:02:15.2022398Z 	cat <<-EOF
2026-11-06T03:02:15.2022939Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:02:15.2023315Z 	See "man sudo_root" for details.
2026-11-06T03:02:15.2023553Z 	
2026-11-06T03:02:15.2023727Z 	EOF
2026-11-06T03:02:15.2023905Z     fi
2026-11-06T03:02:15.2024305Z     esac
2026-11-06T03:02:15.2024483Z fi
2026-11-06T03:02:15.2024587Z 
2026-11-06T03:02:15.2024733Z # if the command-not-found package is installed, use it
2026-11-06T03:02:15.2025216Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:15.2025661Z 	function command_not_found_handle {
2026-11-06T03:02:15.2025994Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:02:15.2026364Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:02:15.2026678Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:02:15.2026946Z                    return $?
2026-11-06T03:02:15.2027267Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:15.2027681Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:02:15.2027994Z                    return $?
2026-11-06T03:02:15.2028206Z 		else
2026-11-06T03:02:15.2028432Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:02:15.2028710Z 		   return 127
2026-11-06T03:02:15.2028906Z 		fi
2026-11-06T03:02:15.2029081Z 	}
