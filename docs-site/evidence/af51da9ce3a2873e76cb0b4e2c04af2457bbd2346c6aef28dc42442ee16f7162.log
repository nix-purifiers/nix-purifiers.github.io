2026-11-07T06:33:15.0408149Z 
2026-11-07T06:33:15.0408262Z # sudo hint
2026-11-07T06:33:15.0408928Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:15.0409747Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T06:33:15.0410166Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T06:33:15.0410532Z 	cat <<-EOF
2026-11-07T06:33:15.0410961Z 	To run a command as administrator (user "root"), use "sudo <command>".
