2026-11-06T02:59:25.2765976Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:59:25.2766172Z 
2026-11-06T02:59:25.2766331Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:59:25.2766670Z # this file has to be sourced in /etc/profile.
2026-11-06T02:59:25.2766844Z 
2026-11-06T02:59:25.2766945Z # If not running interactively, don't do anything
2026-11-06T02:59:25.2767192Z [ -z "$PS1" ] && return
2026-11-06T02:59:25.2767308Z 
2026-11-06T02:59:25.2767437Z # check the window size after each command and, if necessary,
2026-11-06T02:59:25.2767729Z # update the values of LINES and COLUMNS.
2026-11-06T02:59:25.2767958Z shopt -s checkwinsize
2026-11-06T02:59:25.2768069Z 
2026-11-06T02:59:25.2768242Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:59:25.2768623Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:59:25.2768909Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:59:25.2769125Z fi
2026-11-06T02:59:25.2769208Z 
2026-11-06T02:59:25.2769351Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:59:25.2769709Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:59:25.2770053Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:59:25.2770327Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:59:25.2770557Z fi
2026-11-06T02:59:25.2770635Z 
2026-11-06T02:59:25.2770798Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:59:25.2771139Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:59:25.2771382Z #case "$TERM" in
2026-11-06T02:59:25.2771547Z #xterm*|rxvt*)
2026-11-06T02:59:25.2771793Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:59:25.2772076Z #    ;;
2026-11-06T02:59:25.2772225Z #*)
2026-11-06T02:59:25.2772365Z #    ;;
2026-11-06T02:59:25.2772514Z #esac
2026-11-06T02:59:25.2772579Z 
