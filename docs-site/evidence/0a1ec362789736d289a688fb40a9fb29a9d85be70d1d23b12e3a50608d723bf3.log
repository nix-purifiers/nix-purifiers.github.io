2026-11-07T11:51:11.4160168Z 
2026-11-07T11:51:11.4160252Z # sudo hint
2026-11-07T11:51:11.4160576Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T11:51:11.4161208Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T11:51:11.4161509Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T11:51:11.4161752Z 	cat <<-EOF
2026-11-07T11:51:11.4162046Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T11:51:11.4162625Z 	See "man sudo_root" for details.
2026-11-07T11:51:11.4162858Z 	
2026-11-07T11:51:11.4163021Z 	EOF
2026-11-07T11:51:11.4163192Z     fi
2026-11-07T11:51:11.4163368Z     esac
2026-11-07T11:51:11.4163545Z fi
2026-11-07T11:51:11.4163640Z 
2026-11-07T11:51:11.4163791Z # if the command-not-found package is installed, use it
2026-11-07T11:51:11.4164290Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:11.4164751Z 	function command_not_found_handle {
2026-11-07T11:51:11.4165084Z 	        # check because c-n-f could've been removed in the meantime
2026-11-07T11:51:11.4165460Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-07T11:51:11.4165772Z 		   /usr/lib/command-not-found -- "$1"
2026-11-07T11:51:11.4166045Z                    return $?
2026-11-07T11:51:11.4166371Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:11.4167111Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-07T11:51:11.4167465Z                    return $?
2026-11-07T11:51:11.4167683Z 		else
2026-11-07T11:51:11.4167895Z 		   printf "%s: command not found\n" "$1" >&2
