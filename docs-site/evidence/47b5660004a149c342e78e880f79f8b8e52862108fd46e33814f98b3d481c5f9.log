2026-11-07T11:58:52.0338610Z # sudo hint
2026-11-07T11:58:52.0338779Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T11:58:52.0338998Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T11:58:52.0339247Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T11:58:52.0339444Z 	cat <<-EOF
2026-11-07T11:58:52.0339677Z 	To run a command as administrator (user "root"), use "sudo <command>".
