2026-11-06T02:57:03.9924609Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:57:03.9925038Z 
2026-11-06T02:57:03.9925368Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:57:03.9926093Z # this file has to be sourced in /etc/profile.
2026-11-06T02:57:03.9926455Z 
2026-11-06T02:57:03.9926705Z # If not running interactively, don't do anything
2026-11-06T02:57:03.9927224Z [ -z "$PS1" ] && return
2026-11-06T02:57:03.9927456Z 
2026-11-06T02:57:03.9927725Z # check the window size after each command and, if necessary,
2026-11-06T02:57:03.9928318Z # update the values of LINES and COLUMNS.
2026-11-06T02:57:03.9928787Z shopt -s checkwinsize
2026-11-06T02:57:03.9929018Z 
2026-11-06T02:57:03.9929371Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:57:03.9930156Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:57:03.9931077Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:57:03.9931524Z fi
2026-11-06T02:57:03.9931685Z 
2026-11-06T02:57:03.9931983Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:57:03.9932749Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:57:03.9933486Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:57:03.9933858Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:57:03.9934168Z fi
2026-11-06T02:57:03.9934266Z 
