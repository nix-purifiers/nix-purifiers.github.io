2026-11-06T03:01:14.8598861Z # sudo hint
2026-11-06T03:01:14.8599125Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:01:14.8599438Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
