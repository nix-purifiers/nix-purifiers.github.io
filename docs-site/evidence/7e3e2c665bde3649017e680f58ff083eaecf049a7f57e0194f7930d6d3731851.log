2026-11-06T02:57:03.7409641Z #fi
2026-11-06T02:57:03.7409769Z 
2026-11-06T02:57:03.7409870Z # sudo hint
2026-11-06T02:57:03.7410260Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:57:03.7410985Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:57:03.7411708Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:57:03.7412111Z 	cat <<-EOF
2026-11-06T02:57:03.7412482Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:57:03.7412866Z 	See "man sudo_root" for details.
2026-11-06T02:57:03.7413415Z 	
2026-11-06T02:57:03.7413618Z 	EOF
2026-11-06T02:57:03.7413882Z     fi
2026-11-06T02:57:03.7414131Z     esac
2026-11-06T02:57:03.7414318Z fi
2026-11-06T02:57:03.7414455Z 
2026-11-06T02:57:03.7414634Z # if the command-not-found package is installed, use it
2026-11-06T02:57:03.7415139Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:57:03.7415631Z 	function command_not_found_handle {
2026-11-06T02:57:03.7416031Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:57:03.7416429Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:57:03.7416800Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:57:03.7417125Z                    return $?
2026-11-06T02:57:03.7417526Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:57:03.7418017Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:57:03.7418384Z                    return $?
2026-11-06T02:57:03.7418837Z 		else
2026-11-06T02:57:03.7419070Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:57:03.7419354Z 		   return 127
