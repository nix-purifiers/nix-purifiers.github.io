2026-11-07T11:51:14.7963090Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T11:51:14.7963328Z 
2026-11-07T11:51:14.7963537Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T11:51:14.7964234Z # this file has to be sourced in /etc/profile.
2026-11-07T11:51:14.7964478Z 
2026-11-07T11:51:14.7964636Z # If not running interactively, don't do anything
2026-11-07T11:51:14.7964980Z [ -z "$PS1" ] && return
2026-11-07T11:51:14.7965200Z 
2026-11-07T11:51:14.7965356Z # check the window size after each command and, if necessary,
2026-11-07T11:51:14.7965722Z # update the values of LINES and COLUMNS.
2026-11-07T11:51:14.7966046Z shopt -s checkwinsize
2026-11-07T11:51:14.7966210Z 
2026-11-07T11:51:14.7966439Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T11:51:14.7966932Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T11:51:14.7967350Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T11:51:14.7967643Z fi
2026-11-07T11:51:14.7967754Z 
2026-11-07T11:51:14.7968010Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T11:51:14.7968479Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T11:51:14.7968959Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T11:51:14.7969354Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T11:51:14.7969683Z fi
2026-11-07T11:51:14.7969782Z 
2026-11-07T11:51:14.7970503Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T11:51:14.7970989Z # If this is an xterm set the title to user@host:dir
