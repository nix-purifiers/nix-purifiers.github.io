2026-11-07T06:33:16.1693014Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:16.1693334Z 
2026-11-07T06:33:16.1693553Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:16.1694021Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:16.1694277Z 
2026-11-07T06:33:16.1694432Z # If not running interactively, don't do anything
2026-11-07T06:33:16.1694760Z [ -z "$PS1" ] && return
2026-11-07T06:33:16.1694908Z 
2026-11-07T06:33:16.1695119Z # check the window size after each command and, if necessary,
2026-11-07T06:33:16.1695533Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:16.1695952Z shopt -s checkwinsize
2026-11-07T06:33:16.1696127Z 
2026-11-07T06:33:16.1696357Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:16.1696821Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:16.1697233Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:16.1697518Z fi
2026-11-07T06:33:16.1697619Z 
2026-11-07T06:33:16.1697872Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:16.1698337Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:16.1698749Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:16.1699138Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:16.1699461Z fi
2026-11-07T06:33:16.1699626Z 
2026-11-07T06:33:16.1699887Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:16.1700925Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:16.1701258Z #case "$TERM" in
2026-11-07T06:33:16.1701554Z #xterm*|rxvt*)
2026-11-07T06:33:16.1701913Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:16.1702310Z #    ;;
2026-11-07T06:33:16.1702589Z #*)
2026-11-07T06:33:16.1702782Z #    ;;
2026-11-07T06:33:16.1703010Z #esac
2026-11-07T06:33:16.1703122Z 
