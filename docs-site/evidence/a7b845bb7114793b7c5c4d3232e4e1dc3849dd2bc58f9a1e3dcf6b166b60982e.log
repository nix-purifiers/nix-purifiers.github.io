2026-11-06T03:02:45.5748231Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:02:45.5748565Z 
2026-11-06T03:02:45.5748757Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:02:45.5749179Z # this file has to be sourced in /etc/profile.
2026-11-06T03:02:45.5749430Z 
2026-11-06T03:02:45.5749565Z # If not running interactively, don't do anything
2026-11-06T03:02:45.5749911Z [ -z "$PS1" ] && return
2026-11-06T03:02:45.5750050Z 
2026-11-06T03:02:45.5750259Z # check the window size after each command and, if necessary,
2026-11-06T03:02:45.5750668Z # update the values of LINES and COLUMNS.
2026-11-06T03:02:45.5750965Z shopt -s checkwinsize
2026-11-06T03:02:45.5751132Z 
2026-11-06T03:02:45.5751412Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:02:45.5751889Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:02:45.5752241Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:02:45.5752612Z fi
2026-11-06T03:02:45.5752749Z 
2026-11-06T03:02:45.5752941Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:02:45.5753685Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:02:45.5754112Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:02:45.5754451Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:02:45.5754832Z fi
2026-11-06T03:02:45.5754945Z 
2026-11-06T03:02:45.5755140Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:02:45.5755597Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:02:45.5755916Z #case "$TERM" in
2026-11-06T03:02:45.5756228Z #xterm*|rxvt*)
2026-11-06T03:02:45.5756631Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:02:45.5757004Z #    ;;
2026-11-06T03:02:45.5757227Z #*)
2026-11-06T03:02:45.5757426Z #    ;;
2026-11-06T03:02:45.5757615Z #esac
2026-11-06T03:02:45.5757793Z 
2026-11-06T03:02:45.5757920Z # enable bash completion in interactive shells
2026-11-06T03:02:45.5758278Z #if ! shopt -oq posix; then
2026-11-06T03:02:45.5758648Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:02:45.5759035Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:02:45.5759361Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:02:45.5759727Z #    . /etc/bash_completion
2026-11-06T03:02:45.5759977Z #  fi
2026-11-06T03:02:45.5760167Z #fi
2026-11-06T03:02:45.5760328Z 
2026-11-06T03:02:45.5760411Z # sudo hint
2026-11-06T03:02:45.5760741Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:02:45.5761209Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:02:45.5761552Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:02:45.5762159Z 	cat <<-EOF
2026-11-06T03:02:45.5762618Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:02:45.5763044Z 	See "man sudo_root" for details.
2026-11-06T03:02:45.5763906Z 	
2026-11-06T03:02:45.5764125Z 	EOF
2026-11-06T03:02:45.5764320Z     fi
2026-11-06T03:02:45.5764556Z     esac
2026-11-06T03:02:45.5764792Z fi
2026-11-06T03:02:45.5764912Z 
2026-11-06T03:02:45.5765047Z # if the command-not-found package is installed, use it
2026-11-06T03:02:45.5765605Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:45.5766068Z 	function command_not_found_handle {
2026-11-06T03:02:45.5766448Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:02:45.5766868Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:02:45.5767188Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:02:45.5767508Z                    return $?
2026-11-06T03:02:45.5767876Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:45.5768351Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:02:45.5768752Z                    return $?
2026-11-06T03:02:45.5769008Z 		else
2026-11-06T03:02:45.5769294Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:02:45.5769701Z 		   return 127
