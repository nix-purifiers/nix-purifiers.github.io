    "ant-purifier": {
      "limitations": [
        {
          "text": "The default modern-v1 plugin is compiled with --release 11 (Java 11 bytecode/API target); the JVM loading it must support that class format. This target does not establish a Java 11 lifecycle point. The opt-in legacy-basic-v1 profile uses a separate Java 6-targeted collector; executed combinations are recorded separately.",
          "sourceRevision": "4db074129b0dd2ac49fae0988804e1a327a48cfa",
          "evidence": [
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/plugin.nix",
