2026-11-06T03:00:25.1936757Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:00:25.1936989Z 
2026-11-06T03:00:25.1937193Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:00:25.1937574Z # this file has to be sourced in /etc/profile.
2026-11-06T03:00:25.1937761Z 
2026-11-06T03:00:25.1937886Z # If not running interactively, don't do anything
2026-11-06T03:00:25.1938181Z [ -z "$PS1" ] && return
2026-11-06T03:00:25.1938311Z 
2026-11-06T03:00:25.1938464Z # check the window size after each command and, if necessary,
2026-11-06T03:00:25.1938788Z # update the values of LINES and COLUMNS.
2026-11-06T03:00:25.1939051Z shopt -s checkwinsize
2026-11-06T03:00:25.1939185Z 
2026-11-06T03:00:25.1939383Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:00:25.1939815Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:00:25.1940143Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:00:25.1940388Z fi
2026-11-06T03:00:25.1940481Z 
2026-11-06T03:00:25.1940653Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:00:25.1941066Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:00:25.1941482Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:00:25.1942184Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:00:25.1942455Z fi
2026-11-06T03:00:25.1942555Z 
2026-11-06T03:00:25.1942744Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:00:25.1943149Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:00:25.1943425Z #case "$TERM" in
2026-11-06T03:00:25.1943621Z #xterm*|rxvt*)
2026-11-06T03:00:25.1944004Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:00:25.1944499Z #    ;;
2026-11-06T03:00:25.1944680Z #*)
2026-11-06T03:00:25.1944841Z #    ;;
2026-11-06T03:00:25.1945001Z #esac
2026-11-06T03:00:25.1945103Z 
2026-11-06T03:00:25.1945217Z # enable bash completion in interactive shells
2026-11-06T03:00:25.1945516Z #if ! shopt -oq posix; then
2026-11-06T03:00:25.1945811Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:00:25.1946273Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:00:25.1946692Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:00:25.1947042Z #    . /etc/bash_completion
2026-11-06T03:00:25.1947340Z #  fi
2026-11-06T03:00:25.1947569Z #fi
2026-11-06T03:00:25.1947704Z 
2026-11-06T03:00:25.1947806Z # sudo hint
2026-11-06T03:00:25.1948214Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:00:25.1948769Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:00:25.1949155Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:00:25.1949763Z 	cat <<-EOF
2026-11-06T03:00:25.1950209Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:00:25.1950743Z 	See "man sudo_root" for details.
2026-11-06T03:00:25.1951110Z 	
2026-11-06T03:00:25.1951382Z 	EOF
2026-11-06T03:00:25.1951639Z     fi
2026-11-06T03:00:25.1952311Z     esac
2026-11-06T03:00:25.1952580Z fi
2026-11-06T03:00:25.1952724Z 
2026-11-06T03:00:25.1952961Z # if the command-not-found package is installed, use it
2026-11-06T03:00:25.1953757Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:25.1954467Z 	function command_not_found_handle {
2026-11-06T03:00:25.1954980Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:00:25.1955684Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:00:25.1956173Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:00:25.1956576Z                    return $?
2026-11-06T03:00:25.1957113Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:25.1957722Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:00:25.1958185Z                    return $?
2026-11-06T03:00:25.1958495Z 		else
2026-11-06T03:00:25.1958792Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:00:25.1959216Z 		   return 127
2026-11-06T03:00:25.1959519Z 		fi
2026-11-06T03:00:25.1959773Z 	}
