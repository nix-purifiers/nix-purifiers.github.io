2026-11-06T02:57:03.7397715Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:57:03.7397956Z 
2026-11-06T02:57:03.7398169Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:57:03.7398642Z # this file has to be sourced in /etc/profile.
2026-11-06T02:57:03.7398849Z 
2026-11-06T02:57:03.7398994Z # If not running interactively, don't do anything
2026-11-06T02:57:03.7399314Z [ -z "$PS1" ] && return
2026-11-06T02:57:03.7399546Z 
2026-11-06T02:57:03.7399704Z # check the window size after each command and, if necessary,
2026-11-06T02:57:03.7400069Z # update the values of LINES and COLUMNS.
2026-11-06T02:57:03.7400590Z shopt -s checkwinsize
2026-11-06T02:57:03.7400747Z 
2026-11-06T02:57:03.7400997Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:57:03.7401471Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:57:03.7401947Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:57:03.7402268Z fi
2026-11-06T02:57:03.7402377Z 
2026-11-06T02:57:03.7402599Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:57:03.7403071Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:57:03.7403484Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:57:03.7403939Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:57:03.7404246Z fi
2026-11-06T02:57:03.7404347Z 
2026-11-06T02:57:03.7404583Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:57:03.7405025Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:57:03.7405372Z #case "$TERM" in
2026-11-06T02:57:03.7405675Z #xterm*|rxvt*)
2026-11-06T02:57:03.7406023Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:57:03.7406382Z #    ;;
2026-11-06T02:57:03.7406616Z #*)
2026-11-06T02:57:03.7406814Z #    ;;
2026-11-06T02:57:03.7407088Z #esac
2026-11-06T02:57:03.7407216Z 
2026-11-06T02:57:03.7407362Z # enable bash completion in interactive shells
2026-11-06T02:57:03.7407691Z #if ! shopt -oq posix; then
2026-11-06T02:57:03.7408065Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:57:03.7408457Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:57:03.7408853Z #  elif [ -f /etc/bash_completion ]; then
