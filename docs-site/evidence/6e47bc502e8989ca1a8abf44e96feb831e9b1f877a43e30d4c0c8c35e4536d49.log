ns%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":10125,"digest":"sha256:2c2ddef0635644632e980041ca1f291e0ee25b014ced29aec2c762ac9f7197be","download_count":38,"created_at":"2026-10-21T23:57:40Z","updated_at":"2026-10-21T23:57:40Z","browser_download_url":"https://github.com/erlang/rebar3/releases/download/3.28.0/rebar3.sigstore"}],"tarball_url":"https://api.github.com/repos/erlang/rebar3/tarball/3.28.0","zipball_url":"https://api.github.com/repos/erlang/rebar3/zipball/3.28.0","body":"Few interface changes, but some significant behavioural ones:\r\n\r\n- [Remove Certifi dependency and rely on root store](https://github.com/erlang/rebar3/pull/3086)\r\n- [Bump vendored hex_core to 0.20.1](https://github.com/erlang/rebar3/pull/3083)\r\n- [Improve description of rebar3 ct --dir option](https://github.com/erlang/rebar3/pull/3082)\r\n\r\nNote that both the hex_core update and the certifi update are required for security. The removal of Certifi switches Rebar3 to use your operating system's root store, which may cause issues in some limited devices. However, since distrusted intermediary certificates are currently still in Certifi's hex package, we consider it safer to rely on operating system root stores. \r\n\r\nIf your device does not comply with the expected root store, you can configure one with `{ssl_cacerts_path, \"/path/to/cacerts.pem\"}`."},{"url":"https://api