2026-11-07T11:58:52.0332222Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T11:58:52.0332385Z 
2026-11-07T11:58:52.0332499Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T11:58:52.0332925Z # this file has to be sourced in /etc/profile.
2026-11-07T11:58:52.0333085Z 
2026-11-07T11:58:52.0333197Z # If not running interactively, don't do anything
2026-11-07T11:58:52.0333460Z [ -z "$PS1" ] && return
2026-11-07T11:58:52.0333579Z 
2026-11-07T11:58:52.0333674Z # check the window size after each command and, if necessary,
2026-11-07T11:58:52.0333891Z # update the values of LINES and COLUMNS.
2026-11-07T11:58:52.0334056Z shopt -s checkwinsize
2026-11-07T11:58:52.0334187Z 
2026-11-07T11:58:52.0334312Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T11:58:52.0334603Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T11:58:52.0334824Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T11:58:52.0334967Z fi
2026-11-07T11:58:52.0335021Z 
2026-11-07T11:58:52.0335136Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T11:58:52.0335385Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T11:58:52.0335649Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T11:58:52.0335833Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T11:58:52.0335987Z fi
2026-11-07T11:58:52.0336046Z 
2026-11-07T11:58:52.0336158Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T11:58:52.0336385Z # If this is an xterm set the title to user@host:dir
2026-11-07T11:58:52.0336550Z #case "$TERM" in
2026-11-07T11:58:52.0336660Z #xterm*|rxvt*)
2026-11-07T11:58:52.0336826Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T11:58:52.0337018Z #    ;;
2026-11-07T11:58:52.0337114Z #*)
2026-11-07T11:58:52.0337209Z #    ;;
2026-11-07T11:58:52.0337307Z #esac
2026-11-07T11:58:52.0337364Z 
