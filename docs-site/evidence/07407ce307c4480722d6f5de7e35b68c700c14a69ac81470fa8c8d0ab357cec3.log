2026-11-06T03:01:14.8590344Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:01:14.8590527Z 
2026-11-06T03:01:14.8590684Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:01:14.8591022Z # this file has to be sourced in /etc/profile.
2026-11-06T03:01:14.8591181Z 
2026-11-06T03:01:14.8591281Z # If not running interactively, don't do anything
2026-11-06T03:01:14.8591519Z [ -z "$PS1" ] && return
2026-11-06T03:01:14.8591637Z 
2026-11-06T03:01:14.8591764Z # check the window size after each command and, if necessary,
2026-11-06T03:01:14.8592042Z # update the values of LINES and COLUMNS.
2026-11-06T03:01:14.8592268Z shopt -s checkwinsize
2026-11-06T03:01:14.8592378Z 
2026-11-06T03:01:14.8592548Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:01:14.8592899Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:01:14.8593244Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:01:14.8593455Z fi
2026-11-06T03:01:14.8593541Z 
2026-11-06T03:01:14.8593681Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:01:14.8594017Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:01:14.8594356Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:01:14.8594629Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:01:14.8594865Z fi
2026-11-06T03:01:14.8594945Z 
2026-11-06T03:01:14.8595113Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:01:14.8595438Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:01:14.8595670Z #case "$TERM" in
2026-11-06T03:01:14.8595838Z #xterm*|rxvt*)
2026-11-06T03:01:14.8596080Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:01:14.8596347Z #    ;;
2026-11-06T03:01:14.8596490Z #*)
2026-11-06T03:01:14.8596643Z #    ;;
2026-11-06T03:01:14.8596791Z #esac
