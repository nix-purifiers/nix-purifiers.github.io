2026-11-07T04:02:17.6929668Z 
2026-11-07T04:02:17.6929746Z # sudo hint
2026-11-07T04:02:17.6930176Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T04:02:17.6930590Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T04:02:17.6931097Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T04:02:17.6931352Z 	cat <<-EOF
2026-11-07T04:02:17.6931642Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T04:02:17.6932134Z 	See "man sudo_root" for details.
2026-11-07T04:02:17.6932362Z 	
2026-11-07T04:02:17.6932520Z 	EOF
2026-11-07T04:02:17.6932682Z     fi
