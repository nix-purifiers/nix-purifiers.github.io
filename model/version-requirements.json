            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/flake.nix"
          ]
        },
        {
          "text": "legacy-basic-v1 is an explicit x86_64-linux Nix scope with a mandatory live legacyJvmAdapter and actual Ant/Ivy packages. The SDK and manager must have the published output/home/executable/runtime-home identities; version strings never choose replacement SDK inputs. The recorded tested tuple is separate from packaged defaults and bytecode targets.",
          "sourceRevision": "4db074129b0dd2ac49fae0988804e1a327a48cfa",
          "evidence": [
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/sdk.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/runtime.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/read-lock.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/README.md"
          ]
        },
        {
          "text": "The legacy profile exposes dependencies and a source/class tree. Its archive is not native artifact publication fidelity. Packaging/publication tasks, task containers, nested Ant, Javadoc/JUnit tasks, project composition and projections are unsupported. Arbitrary custom-task introspection, additional versions, ARM support and version ranges are not established.",
          "sourceRevision": "4db074129b0dd2ac49fae0988804e1a327a48cfa",
          "evidence": [
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/build-project.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/java-legacy/org/nixpurifiers/ant/legacy/Guard.java",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/README.md"
          ]
        }
      ],
      "projectSelections": [
        {
          "role": "native-tool",
          "name": "Apache Ant",
          "kind": "nix-scope",
          "inputs": [
            "nativeProfile",
            "ant"
          ],
          "description": "Select legacy-basic-v1 explicitly and supply the actual Ant package in the Nix scope; this opt-in profile is restricted to x86_64-linux.",
          "sourceRevision": "4db074129b0dd2ac49fae0988804e1a327a48cfa",
          "evidence": [
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/flake.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/sdk.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/README.md"
          ]
        },
        {
          "role": "native-tool",
          "name": "Apache Ivy",
          "kind": "nix-scope",
          "inputs": [
            "apacheIvy"
          ],
          "description": "For legacy-basic-v1, supply the actual Ivy package in the same Nix scope; its native API and origin belong to the recorded tuple.",
          "sourceRevision": "4db074129b0dd2ac49fae0988804e1a327a48cfa",
          "evidence": [
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/flake.nix",
            "https://github.com/nix-purifiers/ant-purifier/blob/4db074129b0dd2ac49fae0988804e1a327a48cfa/nix/legacy-basic/sdk.nix",
