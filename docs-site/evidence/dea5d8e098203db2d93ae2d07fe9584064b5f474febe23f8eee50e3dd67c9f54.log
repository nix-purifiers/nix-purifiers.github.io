2026-11-06T03:13:44.2973732Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:13:44.2974016Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:13:44.2974294Z #  elif [ -f /etc/bash_completion ]; then
