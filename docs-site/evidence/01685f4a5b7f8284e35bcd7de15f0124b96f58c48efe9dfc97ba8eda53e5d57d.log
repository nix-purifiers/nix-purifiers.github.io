2026-11-06T03:02:10.9181053Z fi
2026-11-06T03:02:10.9181147Z 
2026-11-06T03:02:10.9181283Z # if the command-not-found package is installed, use it
2026-11-06T03:02:10.9181735Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:10.9182161Z 	function command_not_found_handle {
2026-11-06T03:02:10.9182492Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:02:10.9182988Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:02:10.9183335Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:02:10.9183744Z                    return $?
2026-11-06T03:02:10.9184238Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:10.9184902Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:02:10.9185431Z                    return $?
2026-11-06T03:02:10.9185787Z 		else
2026-11-06T03:02:10.9186079Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:02:10.9186449Z 		   return 127
