2026-11-07T05:45:13.0436473Z 
2026-11-07T05:45:13.0436541Z # sudo hint
2026-11-07T05:45:13.0436843Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T05:45:13.0437169Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
