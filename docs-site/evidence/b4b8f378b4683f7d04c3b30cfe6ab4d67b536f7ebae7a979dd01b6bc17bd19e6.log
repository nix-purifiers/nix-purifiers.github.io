2026-11-06T03:02:09.4893762Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:02:09.4894202Z 
2026-11-06T03:02:09.4894542Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:02:09.4895295Z # this file has to be sourced in /etc/profile.
2026-11-06T03:02:09.4895664Z 
2026-11-06T03:02:09.4895894Z # If not running interactively, don't do anything
2026-11-06T03:02:09.4896438Z [ -z "$PS1" ] && return
2026-11-06T03:02:09.4896677Z 
2026-11-06T03:02:09.4896954Z # check the window size after each command and, if necessary,
2026-11-06T03:02:09.4897577Z # update the values of LINES and COLUMNS.
2026-11-06T03:02:09.4898065Z shopt -s checkwinsize
2026-11-06T03:02:09.4898306Z 
2026-11-06T03:02:09.4898672Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:02:09.4899795Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:02:09.4900419Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:02:09.4900889Z fi
2026-11-06T03:02:09.4901065Z 
2026-11-06T03:02:09.4901376Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:02:09.4902142Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:02:09.4902654Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:02:09.4903069Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:02:09.4903387Z fi
2026-11-06T03:02:09.4903505Z 
2026-11-06T03:02:09.4903734Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:02:09.4904217Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:02:09.4904761Z #case "$TERM" in
2026-11-06T03:02:09.4905132Z #xterm*|rxvt*)
2026-11-06T03:02:09.4905641Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:02:09.4906264Z #    ;;
2026-11-06T03:02:09.4906576Z #*)
2026-11-06T03:02:09.4906976Z #    ;;
2026-11-06T03:02:09.4907467Z #esac
2026-11-06T03:02:09.4907696Z 
2026-11-06T03:02:09.4907870Z # enable bash completion in interactive shells
2026-11-06T03:02:09.4908203Z #if ! shopt -oq posix; then
2026-11-06T03:02:09.4908536Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:02:09.4908934Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:02:09.4909526Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:02:09.4909833Z #    . /etc/bash_completion
2026-11-06T03:02:09.4910098Z #  fi
2026-11-06T03:02:09.4910313Z #fi
2026-11-06T03:02:09.4910438Z 
2026-11-06T03:02:09.4910536Z # sudo hint
2026-11-06T03:02:09.4910877Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:02:09.4911317Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:02:09.4911647Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:02:09.4911911Z 	cat <<-EOF
2026-11-06T03:02:09.4912235Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:02:09.4912915Z 	See "man sudo_root" for details.
2026-11-06T03:02:09.4913201Z 	
2026-11-06T03:02:09.4913397Z 	EOF
2026-11-06T03:02:09.4913593Z     fi
2026-11-06T03:02:09.4913800Z     esac
2026-11-06T03:02:09.4914013Z fi
2026-11-06T03:02:09.4914122Z 
2026-11-06T03:02:09.4914292Z # if the command-not-found package is installed, use it
2026-11-06T03:02:09.4915007Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:09.4915486Z 	function command_not_found_handle {
2026-11-06T03:02:09.4915853Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:02:09.4916256Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:02:09.4916598Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:02:09.4916889Z                    return $?
2026-11-06T03:02:09.4917236Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:02:09.4917694Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:02:09.4918198Z                    return $?
2026-11-06T03:02:09.4918489Z 		else
2026-11-06T03:02:09.4918732Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:02:09.4919101Z 		   return 127
2026-11-06T03:02:09.4919703Z 		fi
2026-11-06T03:02:09.4920030Z 	}
