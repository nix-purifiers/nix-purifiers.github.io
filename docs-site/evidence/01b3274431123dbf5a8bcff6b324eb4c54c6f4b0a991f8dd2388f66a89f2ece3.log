javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7981317Z # System-wide .bashrc file for interactive bash(1) shells.
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7981736Z 
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7982074Z # To enable the settings / commands in this file for login shells as well,
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7982764Z # this file has to be sourced in /etc/profile.
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7983580Z 
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7983835Z # If not running interactively, don't do anything
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7984376Z [ -z "$PS1" ] && return
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7984629Z 
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7984897Z # check the window size after each command and, if necessary,
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7985811Z # update the values of LINES and COLUMNS.
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7986320Z shopt -s checkwinsize
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7986570Z 
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7986966Z # set variable identifying the chroot you work in (used in the prompt below)
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7987825Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7988462Z     debian_chroot=$(cat /etc/debian_chroot)
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7988948Z fi
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7989112Z 
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7989428Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7990227Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7990986Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7991614Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7992291Z fi
javadoc-link-metadata	UNKNOWN STEP	2026-11-06T20:46:53.7992465Z 
