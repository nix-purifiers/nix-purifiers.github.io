2026-11-07T04:02:17.6933104Z 
2026-11-07T04:02:17.6933251Z # if the command-not-found package is installed, use it
2026-11-07T04:02:17.6933752Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T04:02:17.6934211Z 	function command_not_found_handle {
2026-11-07T04:02:17.6934545Z 	        # check because c-n-f could've been removed in the meantime
2026-11-07T04:02:17.6934935Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-07T04:02:17.6935254Z 		   /usr/lib/command-not-found -- "$1"
2026-11-07T04:02:17.6935521Z                    return $?
2026-11-07T04:02:17.6936204Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T04:02:17.6936622Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-07T04:02:17.6936947Z                    return $?
2026-11-07T04:02:17.6937156Z 		else
