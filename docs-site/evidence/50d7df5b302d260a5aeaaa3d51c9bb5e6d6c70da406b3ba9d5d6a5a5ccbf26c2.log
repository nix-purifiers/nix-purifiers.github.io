2026-11-06T02:56:57.9382177Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:56:57.9382475Z 
2026-11-06T02:56:57.9382667Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:56:57.9383150Z # this file has to be sourced in /etc/profile.
2026-11-06T02:56:57.9383352Z 
2026-11-06T02:56:57.9383500Z # If not running interactively, don't do anything
2026-11-06T02:56:57.9383859Z [ -z "$PS1" ] && return
2026-11-06T02:56:57.9384014Z 
2026-11-06T02:56:57.9384231Z # check the window size after each command and, if necessary,
2026-11-06T02:56:57.9384612Z # update the values of LINES and COLUMNS.
2026-11-06T02:56:57.9384942Z shopt -s checkwinsize
2026-11-06T02:56:57.9385100Z 
2026-11-06T02:56:57.9385314Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:56:57.9385841Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:56:57.9386254Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:56:57.9386548Z fi
2026-11-06T02:56:57.9386639Z 
2026-11-06T02:56:57.9386865Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:56:57.9387322Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:56:57.9387724Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:56:57.9388239Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:56:57.9388581Z fi
2026-11-06T02:56:57.9388674Z 
2026-11-06T02:56:57.9389018Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:56:57.9389448Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:56:57.9389758Z #case "$TERM" in
2026-11-06T02:56:57.9390318Z #xterm*|rxvt*)
2026-11-06T02:56:57.9390651Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:56:57.9391058Z #    ;;
2026-11-06T02:56:57.9391263Z #*)
2026-11-06T02:56:57.9391456Z #    ;;
2026-11-06T02:56:57.9391738Z #esac
2026-11-06T02:56:57.9391842Z 
