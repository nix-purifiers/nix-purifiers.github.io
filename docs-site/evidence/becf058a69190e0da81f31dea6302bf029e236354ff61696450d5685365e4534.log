2026-11-07T06:33:13.7006385Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:13.7006521Z 
2026-11-07T06:33:13.7006633Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:13.7006856Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:13.7006969Z 
2026-11-07T06:33:13.7007045Z # If not running interactively, don't do anything
2026-11-07T06:33:13.7007335Z [ -z "$PS1" ] && return
2026-11-07T06:33:13.7007464Z 
2026-11-07T06:33:13.7007684Z # check the window size after each command and, if necessary,
2026-11-07T06:33:13.7008024Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:13.7008299Z shopt -s checkwinsize
2026-11-07T06:33:13.7008435Z 
2026-11-07T06:33:13.7008639Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:13.7009057Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:13.7009362Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:13.7009591Z fi
2026-11-07T06:33:13.7009676Z 
2026-11-07T06:33:13.7009833Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:13.7010213Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:13.7010560Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:13.7010849Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:13.7011092Z fi
2026-11-07T06:33:13.7011180Z 
2026-11-07T06:33:13.7011413Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:13.7011757Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:13.7012184Z #case "$TERM" in
2026-11-07T06:33:13.7012307Z #xterm*|rxvt*)
2026-11-07T06:33:13.7012485Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:13.7012678Z #    ;;
2026-11-07T06:33:13.7012777Z #*)
2026-11-07T06:33:13.7012877Z #    ;;
2026-11-07T06:33:13.7012974Z #esac
2026-11-07T06:33:13.7013036Z 
2026-11-07T06:33:13.7013111Z # enable bash completion in interactive shells
2026-11-07T06:33:13.7013312Z #if ! shopt -oq posix; then
2026-11-07T06:33:13.7013549Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-07T06:33:13.7013861Z #    . /usr/share/bash-completion/bash_completion
2026-11-07T06:33:13.7014278Z #  elif [ -f /etc/bash_completion ]; then
2026-11-07T06:33:13.7014515Z #    . /etc/bash_completion
2026-11-07T06:33:13.7014709Z #  fi
2026-11-07T06:33:13.7014865Z #fi
2026-11-07T06:33:13.7014958Z 
2026-11-07T06:33:13.7015025Z # sudo hint
2026-11-07T06:33:13.7015294Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:13.7015815Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T06:33:13.7016078Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T06:33:13.7016296Z 	cat <<-EOF
2026-11-07T06:33:13.7016554Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T06:33:13.7016817Z 	See "man sudo_root" for details.
2026-11-07T06:33:13.7016952Z 	
2026-11-07T06:33:13.7017050Z 	EOF
