2026-11-07T06:33:16.1705786Z # sudo hint
2026-11-07T06:33:16.1706406Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:16.1706938Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
