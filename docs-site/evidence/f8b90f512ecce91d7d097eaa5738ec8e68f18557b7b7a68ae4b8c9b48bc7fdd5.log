2026-11-06T03:00:21.8456577Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:00:21.8456762Z 
2026-11-06T03:00:21.8456980Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:00:21.8457450Z # this file has to be sourced in /etc/profile.
2026-11-06T03:00:21.8457612Z 
2026-11-06T03:00:21.8457971Z # If not running interactively, don't do anything
2026-11-06T03:00:21.8458334Z [ -z "$PS1" ] && return
2026-11-06T03:00:21.8458474Z 
2026-11-06T03:00:21.8458607Z # check the window size after each command and, if necessary,
2026-11-06T03:00:21.8458886Z # update the values of LINES and COLUMNS.
2026-11-06T03:00:21.8459115Z shopt -s checkwinsize
2026-11-06T03:00:21.8459227Z 
2026-11-06T03:00:21.8459387Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:00:21.8459744Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:00:21.8460033Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:00:21.8460252Z fi
2026-11-06T03:00:21.8460329Z 
2026-11-06T03:00:21.8460476Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:00:21.8460817Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:00:21.8461141Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:00:21.8461398Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:00:21.8461618Z fi
2026-11-06T03:00:21.8461699Z 
2026-11-06T03:00:21.8461855Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:00:21.8462169Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:00:21.8462403Z #case "$TERM" in
2026-11-06T03:00:21.8462569Z #xterm*|rxvt*)
2026-11-06T03:00:21.8462810Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:00:21.8463074Z #    ;;
2026-11-06T03:00:21.8463217Z #*)
2026-11-06T03:00:21.8463367Z #    ;;
2026-11-06T03:00:21.8463507Z #esac
2026-11-06T03:00:21.8463586Z 
2026-11-06T03:00:21.8463704Z # enable bash completion in interactive shells
2026-11-06T03:00:21.8464083Z #if ! shopt -oq posix; then
2026-11-06T03:00:21.8464447Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:00:21.8464867Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:00:21.8465248Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:00:21.8465629Z #    . /etc/bash_completion
2026-11-06T03:00:21.8465975Z #  fi
2026-11-06T03:00:21.8466264Z #fi
2026-11-06T03:00:21.8466376Z 
2026-11-06T03:00:21.8466447Z # sudo hint
2026-11-06T03:00:21.8466696Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:00:21.8467004Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:00:21.8467231Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:00:21.8467436Z 	cat <<-EOF
2026-11-06T03:00:21.8467998Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:00:21.8468298Z 	See "man sudo_root" for details.
2026-11-06T03:00:21.8468492Z 	
2026-11-06T03:00:21.8468627Z 	EOF
2026-11-06T03:00:21.8468766Z     fi
2026-11-06T03:00:21.8468913Z     esac
2026-11-06T03:00:21.8469151Z fi
2026-11-06T03:00:21.8469228Z 
2026-11-06T03:00:21.8469348Z # if the command-not-found package is installed, use it
2026-11-06T03:00:21.8469727Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:21.8470073Z 	function command_not_found_handle {
2026-11-06T03:00:21.8470328Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:00:21.8470617Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:00:21.8470866Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:00:21.8471073Z                    return $?
2026-11-06T03:00:21.8471323Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:00:21.8471640Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:00:21.8471888Z                    return $?
2026-11-06T03:00:21.8472058Z 		else
2026-11-06T03:00:21.8472243Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:00:21.8472460Z 		   return 127
2026-11-06T03:00:21.8472613Z 		fi
2026-11-06T03:00:21.8472756Z 	}
