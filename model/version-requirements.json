          "sourceRevision": "6c3e166c8d2826e2b826c770025c9109f118a771",
          "evidence": [
            "https://github.com/nix-purifiers/luarocks-purifier/blob/6c3e166c8d2826e2b826c770025c9109f118a771/nix/lib/lua.nix",
            "https://github.com/nix-purifiers/luarocks-purifier/blob/6c3e166c8d2826e2b826c770025c9109f118a771/pkgs/cli/default.nix"
          ]
        }
      ],
      "projectSelections": [
        {
          "role": "project-runtime",
          "name": "Lua",
          "kind": "lockfile",
          "inputs": [
            "luarocks-purifier.lock.json"
          ],
          "description": "The lock\u2019s lua selection chooses the interpreter, ABI and matching LuaRocks package.",
          "sourceRevision": "6c3e166c8d2826e2b826c770025c9109f118a771",
          "evidence": [
            "https://github.com/nix-purifiers/luarocks-purifier/blob/6c3e166c8d2826e2b826c770025c9109f118a771/nix/lib/lua.nix",
            "https://github.com/nix-purifiers/luarocks-purifier/blob/6c3e166c8d2826e2b826c770025c9109f118a771/pkgs/cli/default.nix"
          ]
        }
      ]
    },
    "swiftpm-purifier": {
      "limitations": [
        {
          "text": "This pinned Swift 6.3 toolchain is exposed for x86_64-linux and aarch64-darwin, not aarch64-linux. The package set marks its ARM64 Linux compiler broken because of its linker.",
          "sourceRevision": "cd52ed8444afc1561ec1289a7ead04d6a2556ea0",
          "evidence": [
            "https://github.com/nix-purifiers/swiftpm-purifier/blob/cd52ed8444afc1561ec1289a7ead04d6a2556ea0/flake.nix",
            "https://github.com/nix-purifiers/swiftpm-purifier/blob/cd52ed8444afc1561ec1289a7ead04d6a2556ea0/pkgs/toolchain/default.nix"
          ]
        },
        {
          "text": "macOS uses the pinned Swift and Apple SDK packages rather than Xcode. The pinned macOS Swift package has no XCTest runner, so the project tests output is not run there.",
          "sourceRevision": "cd52ed8444afc1561ec1289a7ead04d6a2556ea0",
          "evidence": [
            "https://github.com/nix-purifiers/swiftpm-purifier/blob/cd52ed8444afc1561ec1289a7ead04d6a2556ea0/flake.nix",
            "https://github.com/nix-purifiers/swiftpm-purifier/blob/cd52ed8444afc1561ec1289a7ead04d6a2556ea0/pkgs/toolchain/default.nix"
          ]
        }
      ],
      "projectSelections": []
    },
    "dotnet-purifier": {
      "limitations": [
