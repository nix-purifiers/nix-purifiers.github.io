2026-11-06T02:59:25.2773942Z #fi
2026-11-06T02:59:25.2773994Z 
2026-11-06T02:59:25.2774037Z # sudo hint
2026-11-06T02:59:25.2774222Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:59:25.2774436Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:59:25.2774589Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:59:25.2774717Z 	cat <<-EOF
2026-11-06T02:59:25.2774870Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:59:25.2775270Z 	See "man sudo_root" for details.
2026-11-06T02:59:25.2775398Z 	
2026-11-06T02:59:25.2775487Z 	EOF
2026-11-06T02:59:25.2775579Z     fi
2026-11-06T02:59:25.2775673Z     esac
2026-11-06T02:59:25.2775779Z fi
2026-11-06T02:59:25.2775836Z 
2026-11-06T02:59:25.2776029Z # if the command-not-found package is installed, use it
2026-11-06T02:59:25.2776614Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:59:25.2776985Z 	function command_not_found_handle {
2026-11-06T02:59:25.2777258Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:59:25.2777565Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:59:25.2777825Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:59:25.2778046Z                    return $?
2026-11-06T02:59:25.2778311Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:59:25.2778664Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:59:25.2778926Z                    return $?
2026-11-06T02:59:25.2779103Z 		else
2026-11-06T02:59:25.2779276Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:59:25.2779497Z 		   return 127
2026-11-06T02:59:25.2779650Z 		fi
2026-11-06T02:59:25.2779795Z 	}
