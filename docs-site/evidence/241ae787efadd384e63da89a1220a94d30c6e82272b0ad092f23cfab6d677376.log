2026-11-07T11:51:13.3475923Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T11:51:13.3476188Z 
2026-11-07T11:51:13.3476371Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T11:51:13.3476861Z # this file has to be sourced in /etc/profile.
2026-11-07T11:51:13.3477088Z 
2026-11-07T11:51:13.3477215Z # If not running interactively, don't do anything
2026-11-07T11:51:13.3477638Z [ -z "$PS1" ] && return
2026-11-07T11:51:13.3477782Z 
2026-11-07T11:51:13.3477969Z # check the window size after each command and, if necessary,
2026-11-07T11:51:13.3478332Z # update the values of LINES and COLUMNS.
2026-11-07T11:51:13.3478661Z shopt -s checkwinsize
2026-11-07T11:51:13.3478819Z 
2026-11-07T11:51:13.3479032Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T11:51:13.3479571Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T11:51:13.3479956Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T11:51:13.3480257Z fi
2026-11-07T11:51:13.3480393Z 
2026-11-07T11:51:13.3480602Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T11:51:13.3481065Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T11:51:13.3482082Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T11:51:13.3482483Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T11:51:13.3482798Z fi
2026-11-07T11:51:13.3482947Z 
2026-11-07T11:51:13.3483161Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T11:51:13.3483597Z # If this is an xterm set the title to user@host:dir
2026-11-07T11:51:13.3484549Z #case "$TERM" in
2026-11-07T11:51:13.3484832Z #xterm*|rxvt*)
2026-11-07T11:51:13.3485174Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T11:51:13.3485630Z #    ;;
2026-11-07T11:51:13.3485833Z #*)
2026-11-07T11:51:13.3486056Z #    ;;
2026-11-07T11:51:13.3486300Z #esac
2026-11-07T11:51:13.3486430Z 
2026-11-07T11:51:13.3486554Z # enable bash completion in interactive shells
