2026-11-06T03:18:56.8071668Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:18:56.8071821Z 
2026-11-06T03:18:56.8071935Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:18:56.8072165Z # this file has to be sourced in /etc/profile.
2026-11-06T03:18:56.8072280Z 
2026-11-06T03:18:56.8072357Z # If not running interactively, don't do anything
2026-11-06T03:18:56.8072537Z [ -z "$PS1" ] && return
2026-11-06T03:18:56.8072622Z 
2026-11-06T03:18:56.8072718Z # check the window size after each command and, if necessary,
2026-11-06T03:18:56.8073152Z # update the values of LINES and COLUMNS.
2026-11-06T03:18:56.8073404Z shopt -s checkwinsize
2026-11-06T03:18:56.8073547Z 
2026-11-06T03:18:56.8073715Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:18:56.8074094Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:18:56.8074388Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:18:56.8074623Z fi
2026-11-06T03:18:56.8074701Z 
2026-11-06T03:18:56.8074810Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:18:56.8075081Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:18:56.8075311Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:18:56.8075508Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:18:56.8075680Z fi
2026-11-06T03:18:56.8075743Z 
2026-11-06T03:18:56.8075869Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:18:56.8076128Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:18:56.8076311Z #case "$TERM" in
2026-11-06T03:18:56.8076447Z #xterm*|rxvt*)
2026-11-06T03:18:56.8076648Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:18:56.8076868Z #    ;;
2026-11-06T03:18:56.8076983Z #*)
2026-11-06T03:18:56.8077092Z #    ;;
2026-11-06T03:18:56.8077213Z #esac
2026-11-06T03:18:56.8077283Z 
2026-11-06T03:18:56.8077371Z # enable bash completion in interactive shells
2026-11-06T03:18:56.8077590Z #if ! shopt -oq posix; then
2026-11-06T03:18:56.8077810Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:18:56.8078052Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:18:56.8078256Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:18:56.8078437Z #    . /etc/bash_completion
2026-11-06T03:18:56.8078580Z #  fi
2026-11-06T03:18:56.8078694Z #fi
2026-11-06T03:18:56.8078760Z 
2026-11-06T03:18:56.8078812Z # sudo hint
2026-11-06T03:18:56.8079025Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:18:56.8079301Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:18:56.8079502Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:18:56.8079654Z 	cat <<-EOF
2026-11-06T03:18:56.8079851Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:18:56.8080405Z 	See "man sudo_root" for details.
2026-11-06T03:18:56.8080541Z 	
2026-11-06T03:18:56.8080652Z 	EOF
2026-11-06T03:18:56.8080759Z     fi
2026-11-06T03:18:56.8081023Z     esac
2026-11-06T03:18:56.8081140Z fi
2026-11-06T03:18:56.8081203Z 
2026-11-06T03:18:56.8081300Z # if the command-not-found package is installed, use it
2026-11-06T03:18:56.8081641Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:18:56.8082018Z 	function command_not_found_handle {
2026-11-06T03:18:56.8082288Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:18:56.8082598Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:18:56.8082905Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:18:56.8083295Z                    return $?
2026-11-06T03:18:56.8083563Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:18:56.8083925Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:18:56.8084209Z                    return $?
2026-11-06T03:18:56.8084402Z 		else
2026-11-06T03:18:56.8084593Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:18:56.8084833Z 		   return 127
