iles`. Each checkout becomes\n# a repository of its files, submodule contents included.\nfor checkout in vendor/cache/*/.bundlecache; do\n  if [ -e \"$checkout\" ]; then\n    (cd \"$(dirname \"$checkout\")\" && git init -q\ngit add -A\n)\n  fi\ndone\n# The locked Bundler, installed from the cache, so the build runs the\n# Bundler version of BUNDLED WITH and Bundler has nothing to fetch.\nnative_gem_install --install-dir \"$GEM_HOME\" --bindir \"$GEM_HOME/bin\" \\\n  vendor/cache/bundler-0.9.9.gem\n# Use this SDK's settings writer; this CLI predates `bundle config`.\nruby -rrubygems -rrubygems/user_interaction -e 'gem \"bundler\", ENV.fetch(\"BUNDLER_PURIFIER_BUNDLER_VERSION\")\nrequire \"bundler\"\nBundler.settings[:cache_path] = \"vendor/cache\"\nBundler.settings[:path] = \"vendor/bundle\"\nBundler.settings[:without] = \"\"\n'\n\n\n\nbundle install --local\n# RubyGems writes gem executables with `#! ruby`, which no kernel\n# resolves, so `bundle exec` could not start them. They get the\n# absolute path of this Ruby.\nfor bin in vendor/bundle/ruby/*/bin/*; do\n  if [ -f \"$bin\" ]; then\n    sed -i -E '1s|^#! ?ruby( .*)?$|#!/nix/store/5974zq3a4ind2wfn9mvcxawmacc8x14n-ruby185-gems135-bundler099-gemcutter030-sdk/bin/ruby\\1|' \"$bin\"\n  fi\ndone\nrunHook postBuild\n","builder":"/nix/store/nnm9gdr70ihc6zc9298mzz8jpcgaciql-bash-5.3p20/bin/bash","checkPhase":"runHook preCheck\nbundle exec ruby -Ilib -e 'require %q(incoming_consumer); abort unless IncomingConsumer.answer == 42'\nrunHook postCheck\n","cmakeFlags":"","configureFlags":"","depsBuildBuild":"","depsBuildBuildPropagated":"","depsBuildTarget":"","depsBuildTargetPropagated":"","depsHostHost":"","depsHostHostPropagated":"","depsTargetTarget":"","depsTargetTargetPropagated":"","doCheck":"1","doInstallCheck":"","dontConfigure":"1","installPhase":"runHook preInstall\n# The locked Bundler, for the `bundle` wrapper to run the app with.\n# Native install may prune its writable cache, including Bundler's\n# own archive. The exact hashed SDK input remains in the Nix cache.\nnative_gem_install --install-dir .bundle/purifier/bundler \\\n  /nix/store/ss9rywn5xfgrvyfzq5ahiklqsr6vi8za-bundler-composed-gem-cache/bundler-0.9.9.gem\n# Older Bundler gems mark ERB executable templates as executable.\n# They are generator data, not scripts for fixup to interpret.\nfor template in .bundle/purifier/bundler/gems/bundler-*/lib/bundler/templates/Executable*; do\n  if [ -f \"$template\" ]; then\n    chmod a-x \"$template\"\n  fi\ndone\n# The gem cache served the install; the output keeps the installed\n# bundle under vendor/bundle. The repository for the gemspecs goes.\nrm -rf vendor/cache\ncat > .bundler-purifier.Gemfile <<'RUBY'\nrequire \"/nix/store/d9dq4r8ag644gpsrv2zjvnjx3z8s1gqi-tools/rubygems_inputs.rb\"\neval_gemfile \"Gemfile\"\nRUBY\ncp Gemfile.lock .bundler-purifier.Gemfile.lock\n\nmkdir -p \"$out\"\nrm -rf .git\ncp -r . \"$out\"\n\n# This SDK's generated environment contains absolute install paths.\n# Relocate that cache alongside the installed bundle, keeping its\n# native lock, fingerprint and selected specifications intact.\nsubstituteInPlace \"$out/./.bundle/environment.rb\" \\\n  --replace-fail \"$PWD\" \"$out/.\"\n\nrunHook postInstall\n","mesonFlags":"","name":"bundler-app-tests","nativeBuildInputs":"/nix/store/5974zq3a4ind2wfn9mvcxawmacc8x14n-ruby185-gems135-bundler099-gemcutter030-sdk /nix/store/2wlays4ahsvdx02v84s3x91ri2623qbl-git-minimal-2.56.0","out":"/nix/store/k42kg1wym62xad6znav1slfm3029c10s-bundler-app-tests","outputs":"out","patches":"","propagatedBuildInputs":"","propagatedNativeBuildInputs":"","src":"/nix/store/is71f4n46p3zpx7qik1khdmcqgbfff2j-bundler-source","stdenv":"/nix/store/an9g93vg5b02j74y38zfajswa0f10p2z-stdenv-linux","strictDeps":"","system":"x86_64-linux"},"inputs":{"drvs":{"30hr2syjmfvflwi68acggp3w870ikw5c-bash-5.3p20.drv":{"dynamicOutputs":{},"outputs":["out"]},"87dv8ffbp2g11q93l119wc9ajg10cvfs-bundler-app-rubygems-repository.drv":{"dynamicOutputs":{},"outp