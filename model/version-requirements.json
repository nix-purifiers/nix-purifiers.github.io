          "evidence": [
            "https://github.com/nix-purifiers/sbt-purifier/blob/87efce32058a19fab2bbe5e22ddfc6b18164ced9/pkgs/sbt/default.nix",
            "https://github.com/nix-purifiers/sbt-purifier/blob/87efce32058a19fab2bbe5e22ddfc6b18164ced9/nix/lib/build-sbt-project.nix"
