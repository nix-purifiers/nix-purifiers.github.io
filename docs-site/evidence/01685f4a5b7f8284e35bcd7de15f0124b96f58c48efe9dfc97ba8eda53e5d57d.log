2026-11-06T03:02:10.9177666Z 
2026-11-06T03:02:10.9177737Z # sudo hint
2026-11-06T03:02:10.9178026Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:02:10.9178404Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:02:10.9178673Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:02:10.9179115Z 	cat <<-EOF
2026-11-06T03:02:10.9179734Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:02:10.9180083Z 	See "man sudo_root" for details.
2026-11-06T03:02:10.9180312Z 	
2026-11-06T03:02:10.9180475Z 	EOF
2026-11-06T03:02:10.9180643Z     fi
