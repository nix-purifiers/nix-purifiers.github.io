2026-11-13T10:02:14.9265490Z 
2026-11-13T10:02:14.9265559Z # sudo hint
2026-11-13T10:02:14.9265867Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-13T10:02:14.9266212Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-13T10:02:14.9266435Z     if [ -x /usr/bin/sudo ]; then
2026-11-13T10:02:14.9266626Z 	cat <<-EOF
2026-11-13T10:02:14.9267067Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-13T10:02:14.9267353Z 	See "man sudo_root" for details.
2026-11-13T10:02:14.9267544Z 	
2026-11-13T10:02:14.9267678Z 	EOF
