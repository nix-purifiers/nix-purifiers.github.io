2026-11-07T11:51:14.7980804Z 
2026-11-07T11:51:14.7980975Z # if the command-not-found package is installed, use it
2026-11-07T11:51:14.7981477Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-07T11:51:14.7982011Z 	function command_not_found_handle {
2026-11-07T11:51:14.7982375Z 	        # check because c-n-f could've been removed in the meantime
