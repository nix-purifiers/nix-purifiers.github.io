2026-11-07T06:33:14.4018788Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:14.4018992Z 
2026-11-07T06:33:14.4019142Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:14.4019467Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:14.4019624Z 
2026-11-07T06:33:14.4019728Z # If not running interactively, don't do anything
2026-11-07T06:33:14.4019972Z [ -z "$PS1" ] && return
2026-11-07T06:33:14.4020086Z 
2026-11-07T06:33:14.4020219Z # check the window size after each command and, if necessary,
2026-11-07T06:33:14.4020499Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:14.4020721Z shopt -s checkwinsize
2026-11-07T06:33:14.4020877Z 
2026-11-07T06:33:14.4021044Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:14.4021405Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:14.4021834Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:14.4022082Z fi
2026-11-07T06:33:14.4022163Z 
2026-11-07T06:33:14.4022313Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:14.4022653Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:14.4023011Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:14.4023385Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:14.4023738Z fi
2026-11-07T06:33:14.4023865Z 
2026-11-07T06:33:14.4024104Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:14.4024750Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:14.4025139Z #case "$TERM" in
2026-11-07T06:33:14.4025719Z #xterm*|rxvt*)
2026-11-07T06:33:14.4026137Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:14.4026615Z #    ;;
2026-11-07T06:33:14.4026872Z #*)
2026-11-07T06:33:14.4027099Z #    ;;
2026-11-07T06:33:14.4027332Z #esac
2026-11-07T06:33:14.4027486Z 
2026-11-07T06:33:14.4027631Z # enable bash completion in interactive shells
2026-11-07T06:33:14.4028016Z #if ! shopt -oq posix; then
2026-11-07T06:33:14.4028395Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-07T06:33:14.4028851Z #    . /usr/share/bash-completion/bash_completion
2026-11-07T06:33:14.4029249Z #  elif [ -f /etc/bash_completion ]; then
