2026-11-06T03:13:44.2963296Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:13:44.2963593Z 
2026-11-06T03:13:44.2963834Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:13:44.2964387Z # this file has to be sourced in /etc/profile.
2026-11-06T03:13:44.2964707Z 
2026-11-06T03:13:44.2964889Z # If not running interactively, don't do anything
2026-11-06T03:13:44.2965291Z [ -z "$PS1" ] && return
2026-11-06T03:13:44.2965481Z 
2026-11-06T03:13:44.2965697Z # check the window size after each command and, if necessary,
2026-11-06T03:13:44.2966147Z # update the values of LINES and COLUMNS.
2026-11-06T03:13:44.2966488Z shopt -s checkwinsize
2026-11-06T03:13:44.2966665Z 
2026-11-06T03:13:44.2966935Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:13:44.2967529Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:13:44.2967981Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:13:44.2968314Z fi
2026-11-06T03:13:44.2968433Z 
2026-11-06T03:13:44.2968661Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:13:44.2969240Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:13:44.2969776Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:13:44.2970203Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:13:44.2970503Z fi
2026-11-06T03:13:44.2971156Z 
2026-11-06T03:13:44.2971329Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:13:44.2971657Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:13:44.2971893Z #case "$TERM" in
2026-11-06T03:13:44.2972060Z #xterm*|rxvt*)
2026-11-06T03:13:44.2972304Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:13:44.2972584Z #    ;;
2026-11-06T03:13:44.2972756Z #*)
2026-11-06T03:13:44.2972897Z #    ;;
2026-11-06T03:13:44.2973047Z #esac
2026-11-06T03:13:44.2973137Z 
