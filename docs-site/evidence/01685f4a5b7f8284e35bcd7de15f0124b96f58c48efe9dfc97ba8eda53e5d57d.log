2026-11-06T03:02:10.9164196Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:02:10.9164602Z 
2026-11-06T03:02:10.9164910Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:02:10.9165558Z # this file has to be sourced in /etc/profile.
2026-11-06T03:02:10.9165924Z 
2026-11-06T03:02:10.9166119Z # If not running interactively, don't do anything
2026-11-06T03:02:10.9166636Z [ -z "$PS1" ] && return
2026-11-06T03:02:10.9166874Z 
2026-11-06T03:02:10.9167133Z # check the window size after each command and, if necessary,
2026-11-06T03:02:10.9167743Z # update the values of LINES and COLUMNS.
2026-11-06T03:02:10.9168189Z shopt -s checkwinsize
2026-11-06T03:02:10.9168430Z 
2026-11-06T03:02:10.9168785Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:02:10.9169677Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:02:10.9170041Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:02:10.9170322Z fi
2026-11-06T03:02:10.9170430Z 
2026-11-06T03:02:10.9170600Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:02:10.9171052Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:02:10.9171537Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:02:10.9172032Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:02:10.9172445Z fi
2026-11-06T03:02:10.9172599Z 
2026-11-06T03:02:10.9172943Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:02:10.9173667Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:02:10.9174252Z #case "$TERM" in
2026-11-06T03:02:10.9174478Z #xterm*|rxvt*)
2026-11-06T03:02:10.9174761Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:02:10.9175082Z #    ;;
2026-11-06T03:02:10.9175247Z #*)
2026-11-06T03:02:10.9175416Z #    ;;
2026-11-06T03:02:10.9175576Z #esac
2026-11-06T03:02:10.9175674Z 
