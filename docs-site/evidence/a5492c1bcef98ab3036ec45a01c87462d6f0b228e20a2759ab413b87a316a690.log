2026-11-07T04:02:17.6917000Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T04:02:17.6917246Z 
2026-11-07T04:02:17.6917437Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T04:02:17.6918045Z # this file has to be sourced in /etc/profile.
2026-11-07T04:02:17.6918262Z 
2026-11-07T04:02:17.6918396Z # If not running interactively, don't do anything
2026-11-07T04:02:17.6918731Z [ -z "$PS1" ] && return
2026-11-07T04:02:17.6918890Z 
2026-11-07T04:02:17.6919048Z # check the window size after each command and, if necessary,
2026-11-07T04:02:17.6919477Z # update the values of LINES and COLUMNS.
2026-11-07T04:02:17.6919802Z shopt -s checkwinsize
2026-11-07T04:02:17.6919963Z 
2026-11-07T04:02:17.6920199Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T04:02:17.6920704Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T04:02:17.6921090Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T04:02:17.6921349Z fi
2026-11-07T04:02:17.6921441Z 
2026-11-07T04:02:17.6921626Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T04:02:17.6922074Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T04:02:17.6922500Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T04:02:17.6922829Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T04:02:17.6923134Z fi
2026-11-07T04:02:17.6923229Z 
2026-11-07T04:02:17.6923430Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T04:02:17.6923844Z # If this is an xterm set the title to user@host:dir
2026-11-07T04:02:17.6924282Z #case "$TERM" in
2026-11-07T04:02:17.6924625Z #xterm*|rxvt*)
2026-11-07T04:02:17.6925146Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T04:02:17.6926340Z #    ;;
2026-11-07T04:02:17.6926642Z #*)
2026-11-07T04:02:17.6926919Z #    ;;
2026-11-07T04:02:17.6927215Z #esac
2026-11-07T04:02:17.6927325Z 
