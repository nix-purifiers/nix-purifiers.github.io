2026-11-06T03:13:44.2974802Z #  fi
2026-11-06T03:13:44.2974957Z #fi
2026-11-06T03:13:44.2975032Z 
2026-11-06T03:13:44.2975105Z # sudo hint
2026-11-06T03:13:44.2975359Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:13:44.2975677Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:13:44.2975909Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:13:44.2976100Z 	cat <<-EOF
2026-11-06T03:13:44.2976342Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:13:44.2976832Z 	See "man sudo_root" for details.
2026-11-06T03:13:44.2977035Z 	
2026-11-06T03:13:44.2977173Z 	EOF
2026-11-06T03:13:44.2977319Z     fi
2026-11-06T03:13:44.2977468Z     esac
2026-11-06T03:13:44.2977617Z fi
2026-11-06T03:13:44.2977695Z 
2026-11-06T03:13:44.2977820Z # if the command-not-found package is installed, use it
2026-11-06T03:13:44.2978324Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:13:44.2978676Z 	function command_not_found_handle {
2026-11-06T03:13:44.2978942Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:13:44.2979241Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:13:44.2979505Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:13:44.2979724Z                    return $?
2026-11-06T03:13:44.2979985Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:13:44.2980314Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:13:44.2980739Z                    return $?
2026-11-06T03:13:44.2980951Z 		else
2026-11-06T03:13:44.2981126Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T03:13:44.2981343Z 		   return 127
2026-11-06T03:13:44.2981500Z 		fi
2026-11-06T03:13:44.2981643Z 	}
