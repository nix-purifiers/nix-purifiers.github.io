2026-11-06T02:56:31.6979788Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T02:56:31.6980072Z 
2026-11-06T02:56:31.6980320Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T02:56:31.6980746Z # this file has to be sourced in /etc/profile.
2026-11-06T02:56:31.6980970Z 
2026-11-06T02:56:31.6981095Z # If not running interactively, don't do anything
2026-11-06T02:56:31.6981507Z [ -z "$PS1" ] && return
2026-11-06T02:56:31.6981646Z 
2026-11-06T02:56:31.6981820Z # check the window size after each command and, if necessary,
2026-11-06T02:56:31.6982205Z # update the values of LINES and COLUMNS.
2026-11-06T02:56:31.6982511Z shopt -s checkwinsize
2026-11-06T02:56:31.6982661Z 
2026-11-06T02:56:31.6982866Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T02:56:31.6983380Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T02:56:31.6983779Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T02:56:31.6984101Z fi
2026-11-06T02:56:31.6984208Z 
2026-11-06T02:56:31.6984425Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T02:56:31.6984886Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T02:56:31.6985375Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T02:56:31.6985724Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T02:56:31.6986090Z fi
2026-11-06T02:56:31.6986223Z 
2026-11-06T02:56:31.6988139Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T02:56:31.6988625Z # If this is an xterm set the title to user@host:dir
2026-11-06T02:56:31.6989189Z #case "$TERM" in
2026-11-06T02:56:31.6989421Z #xterm*|rxvt*)
2026-11-06T02:56:31.6990167Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T02:56:31.6990566Z #    ;;
2026-11-06T02:56:31.6990766Z #*)
2026-11-06T02:56:31.6991037Z #    ;;
2026-11-06T02:56:31.6991233Z #esac
2026-11-06T02:56:31.6991355Z 
2026-11-06T02:56:31.6991471Z # enable bash completion in interactive shells
2026-11-06T02:56:31.6991867Z #if ! shopt -oq posix; then
2026-11-06T02:56:31.6992201Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T02:56:31.6992647Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T02:56:31.6992985Z #  elif [ -f /etc/bash_completion ]; then
