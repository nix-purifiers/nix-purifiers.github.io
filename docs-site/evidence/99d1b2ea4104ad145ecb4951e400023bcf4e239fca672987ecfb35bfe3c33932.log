# SPDX-License-Identifier: MIT
name: tier2-runtime
on:
  push:
    branches: [main]
  pull_request:
permissions:
  contents: read
jobs:
  runtime:
    strategy:
      fail-fast: false
      matrix:
        gradle: ['8.14.6', '9.9.0']
        runner: [ubuntu-latest, macos-15]
        include:
          - runner: ubuntu-latest
            system: x86_64-linux
          # GitHub's standard macos-15 runner uses Apple Silicon.
          - runner: macos-15
            system: aarch64-darwin
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 90
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
          # Exact Git-revision archives require complete revision history.
          fetch-depth: 0
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
        with:
          extra_nix_config: |
            sandbox = true
      - name: Verify native Nix system
        env:
          EXPECTED_SYSTEM: ${{ matrix.system }}
        run: |
          test "$(nix eval --impure --raw --expr builtins.currentSystem)" = "$EXPECTED_SYSTEM"
          uname -a
      - name: Allow Linux network isolation
        if: runner.os == 'Linux'
        run: sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
      - name: Independent Petclinic capture, offline test and sandboxed package
        env:
          GRADLE_VERSION: ${{ matrix.gradle }}
        run: python3 tests/tier2-lifecycle.py --gradle-version "$GRADLE_VERSION" --output "$RUNNER_TEMP/gradle-tier2-proof"
      - name: Existing fixture replay, publication, IDE import and negative controls
        if: matrix.gradle == '9.9.0'
        run: |
          nix shell --inputs-from . 'nixpkgs#coreutils' 'nixpkgs#jq' --command bash tests/offline.sh
      - name: Native sandboxed fixture checks
        if: matrix.gradle == '9.9.0'
        run: |
          system=$(nix eval --impure --raw --expr builtins.currentSystem)
          nix build --no-link --max-jobs 2 --cores 2 --print-build-logs \
            ".#checks.$system.java-library" ".#checks.$system.kotlin-core" \
            ".#checks.$system.kotlin-shared" ".#checks.$system.kotlin-app" \
            ".#checks.$system.kotlin-app-runs"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        if: always()
        with:
          name: gradle-tier2-${{ matrix.system }}-${{ matrix.gradle }}
          path: ${{ runner.temp }}/gradle-tier2-proof
          if-no-files-found: error
          retention-days: 14
