2026-11-06T02:56:57.9398833Z # if the command-not-found package is installed, use it
2026-11-06T02:56:57.9399344Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:56:57.9399850Z 	function command_not_found_handle {
