{
  "version": 1,
  "projects": {
    "gradle-purifier": {
      "limitations": [
        {
          "text": "Gradle itself comes from the project\u2019s wrapper; the purifier does not bundle a fixed Gradle distribution.",
          "sourceRevision": "9e0035882868e88d04bec2d80a1ecaa48be0fd5c",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9e0035882868e88d04bec2d80a1ecaa48be0fd5c/src/gradle-purifier.sh",
            "https://github.com/nix-purifiers/gradle-purifier/blob/9e0035882868e88d04bec2d80a1ecaa48be0fd5c/pkgs/gradle-purifier/default.nix"
          ]
        },
        {
          "text": "The recording agent requires Java 17-compatible bytecode and APIs. The released CLI runs it on its bundled JDK 21, independently of the JVM selected to run Gradle.",
          "sourceRevision": "7e89d9aed2b4e075309f6cf2b6d38068e3154b55",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/7e89d9aed2b4e075309f6cf2b6d38068e3154b55/src/gradle-purifier.sh#L465-L469",
            "https://github.com/nix-purifiers/gradle-purifier/blob/7e89d9aed2b4e075309f6cf2b6d38068e3154b55/pkgs/gradle-purifier/default.nix#L31",
            "https://github.com/nix-purifiers/gradle-purifier/blob/7e89d9aed2b4e075309f6cf2b6d38068e3154b55/src/gradle-purifier.sh#L486"
          ]
        },
        {
          "text": "Source mode binds a mandatory actual manager even with zero SDK tasks or only manager-SDK tasks. Exact SDK output/home/Nix contexts and manager executable/runtime home identities are reconstructed from immutable GitHub source pins; Java version strings never select a replacement. Declaration changes require relocking; --java and direct builder JDK overrides cannot mix with this mode.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L295-L314"
          ]
        },
        {
          "text": "Source mode is x86_64-linux with immutable GitHub sources and immutable GitHub transitive inputs only. Original native SDK selections and discovery configuration take precedence; ordinary Gradle/IDE use requires working original discovery and declared manager. Prefetch does not rewrite project/global properties. This mechanism establishes no Java6/7 or version-range compatibility claim.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L295-L328"
          ]
        }
      ],
      "projectSelections": [
        {
          "role": "native-tool",
          "name": "Gradle",
          "kind": "project-file",
          "inputs": [
            "gradlew",
            "gradle/wrapper/gradle-wrapper.properties"
          ],
          "description": "The project\u2019s Gradle wrapper selects the Gradle distribution.",
          "sourceRevision": "9e0035882868e88d04bec2d80a1ecaa48be0fd5c",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9e0035882868e88d04bec2d80a1ecaa48be0fd5c/src/gradle-purifier.sh",
            "https://github.com/nix-purifiers/gradle-purifier/blob/9e0035882868e88d04bec2d80a1ecaa48be0fd5c/pkgs/gradle-purifier/default.nix"
          ]
        },
        {
          "role": "native-tool-runtime",
          "name": "JDK",
          "kind": "environment",
          "inputs": [
            "JAVA_HOME"
          ],
          "description": "For projects without gradle-purifier.sdks.json, JAVA_HOME selects the capture JVM when --java is absent; otherwise the packaged fallback is used.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L300-L324",
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/src/gradle-purifier.sh#L122-L138"
          ]
        },
        {
          "role": "native-tool-runtime",
          "name": "JDK",
          "kind": "command-option",
          "inputs": [
            "--java"
          ],
          "description": "For projects without gradle-purifier.sdks.json, an explicit --java option selects the JDK major for capture.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L300-L324",
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/src/gradle-purifier.sh#L122-L138"
          ]
        },
        {
          "role": "native-tool-runtime",
          "name": "JDK",
          "kind": "project-file",
          "inputs": [
            "gradle-purifier.sdks.json"
          ],
          "description": "On x86_64-linux, the project SDK declaration selects a source-owned manager adapter with explicit executable and runtime home.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L271-L314"
          ]
        },
        {
          "role": "compiler",
          "name": "JDK",
          "kind": "project-file",
          "inputs": [
            "gradle-purifier.sdks.json"
          ],
          "description": "On x86_64-linux, the project SDK declaration supplies immutable SDK candidates; original native Gradle compiler and Javadoc selections must match declared exact SDK identities.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L271-L314"
          ]
        },
        {
          "role": "project-runtime",
          "name": "JDK",
          "kind": "project-file",
          "inputs": [
            "gradle-purifier.sdks.json"
          ],
          "description": "On x86_64-linux, the project SDK declaration supplies immutable SDK candidates; original native Test and JavaExec selections must match declared exact SDK identities.",
          "sourceRevision": "9c19f8d47def476f9afe4d8940f0076f0b95318f",
          "evidence": [
            "https://github.com/nix-purifiers/gradle-purifier/blob/9c19f8d47def476f9afe4d8940f0076f0b95318f/README.md#L271-L314"
          ]
        }
      ]
    },
    "mill-purifier": {
      "limitations": [
        {
          "text": "Projects must pin a Mill version. Mill 0.x is rejected; the integration uses Mill 1.x APIs.",
          "sourceRevision": "5fe02120845491253685bed305d1242b94a2089e",
          "evidence": [
            "https://github.com/nix-purifiers/mill-purifier/blob/5fe02120845491253685bed305d1242b94a2089e/pkgs/cli/mill_purifier.py",
            "https://github.com/nix-purifiers/mill-purifier/blob/5fe02120845491253685bed305d1242b94a2089e/nix/lib/publisher-available.nix"
          ]
        },
        {
          "text": "Maven publication through release requires Mill 1.1.0 or later. Mill 1.0.x and early 1.1 prereleases can build packages and tests but cannot use this publisher.",
          "sourceRevision": "5fe02120845491253685bed305d1242b94a2089e",
          "evidence": [
            "https://github.com/nix-purifiers/mill-purifier/blob/5fe02120845491253685bed305d1242b94a2089e/pkgs/cli/mill_purifier.py",
            "https://github.com/nix-purifiers/mill-purifier/blob/5fe02120845491253685bed305d1242b94a2089e/nix/lib/publisher-available.nix"
          ]
        }
      ],
      "projectSelections": [
        {
          "role": "native-tool",
          "name": "Mill",
          "kind": "project-file",
          "inputs": [
            "build.mill",
            "build.mill.yaml",
            ".mill-version",
            ".config/mill-version"
          ],
          "description": "The project\u2019s mill-version setting selects the launcher used for locking and builds.",
          "sourceRevision": "5fe02120845491253685bed305d1242b94a2089e",
          "evidence": [
            "https://github.com/nix-purifiers/mill-purifier/blob/5fe02120845491253685bed305d1242b94a2089e/pkgs/cli/mill_purifier.py",
            "https://github.com/nix-purifiers/mill-purifier/blob/5fe02120845491253685bed305d1242b94a2089e/nix/lib/publisher-available.nix"
          ]
        }
      ]
    },
    "maven-purifier": {
      "limitations": [
        {
          "text": "Maven 2 and 3.0 capture defaults to Java 8; a selected JAVA_HOME can choose a different JVM, which project plugins must support.",
          "sourceRevision": "d76004928fa0283524e5bca409dd4ffd82d7e22f",
          "evidence": [
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/cli/maven_purifier.py",
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/pkgs/cli/default.nix"
          ]
        },
        {
          "text": "Maven before 3.3.1 does not read .mvn/maven.config. Use the prefetched .maven-purifier/bin/mvn launcher for locked development with those versions.",
          "sourceRevision": "d76004928fa0283524e5bca409dd4ffd82d7e22f",
          "evidence": [
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/cli/maven_purifier.py",
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/pkgs/cli/default.nix"
          ]
        },
        {
          "text": "Native incoming dependency selection requires Maven 3 or newer; Maven 2.2.1 can consume Nix inputs through the sandbox builder. The legacy Maven 2/3.0 recording path cannot use authenticated repositories that require Maven-specific transports.",
          "sourceRevision": "0191b266cbb56449b9d6bed5acb4ce4425224ef0",
          "evidence": [
            "https://github.com/nix-purifiers/maven-purifier/blob/0191b266cbb56449b9d6bed5acb4ce4425224ef0/cli/maven_purifier.py",
            "https://github.com/nix-purifiers/maven-purifier/blob/0191b266cbb56449b9d6bed5acb4ce4425224ef0/pkgs/cli/default.nix",
            "https://github.com/nix-purifiers/maven-purifier/blob/0191b266cbb56449b9d6bed5acb4ce4425224ef0/tests/compatibility/check.py"
          ]
        },
        {
          "text": "The Maven 3 recording classes target Java 8 bytecode; Maven 4-specific recording classes target Java 17. The selected JVM must also meet Maven and project-plugin requirements.",
          "sourceRevision": "d76004928fa0283524e5bca409dd4ffd82d7e22f",
          "evidence": [
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/pkgs/extension/default.nix"
          ]
        }
      ],
      "projectSelections": [
        {
          "role": "native-tool",
          "name": "Maven",
          "kind": "project-file",
          "inputs": [
            ".mvn/wrapper/maven-wrapper.properties"
          ],
          "description": "A Maven wrapper distribution URL selects a version instead of the packaged default.",
          "sourceRevision": "d76004928fa0283524e5bca409dd4ffd82d7e22f",
          "evidence": [
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/cli/maven_purifier.py",
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/pkgs/cli/default.nix"
          ]
        },
        {
          "role": "native-tool-runtime",
          "name": "JDK",
          "kind": "environment",
          "inputs": [
            "JAVA_HOME"
          ],
          "description": "Initial capture records the chosen Java major; relocks and Nix builds retain that selection.",
          "sourceRevision": "d76004928fa0283524e5bca409dd4ffd82d7e22f",
          "evidence": [
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/cli/maven_purifier.py",
            "https://github.com/nix-purifiers/maven-purifier/blob/d76004928fa0283524e5bca409dd4ffd82d7e22f/pkgs/cli/default.nix"
          ]
        }
      ]
    },
    "sbt-purifier": {
      "limitations": [
        {
          "text": "The sbt 0.13 launcher supplied by the wrapper is 0.13.18 and uses Java 8. Use the purifier wrapper for this legacy bootstrap.",
          "sourceRevision": "87efce32058a19fab2bbe5e22ddfc6b18164ced9",
