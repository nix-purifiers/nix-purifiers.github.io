          ]
        }
      ],
      "projectSelections": [
        {
          "role": "native-tool",
          "name": ".NET SDK",
          "kind": "project-file",
          "inputs": [
            "global.json"
          ],
          "description": "global.json selects the project SDK; the configured default SDK major applies when it is absent.",
          "sourceRevision": "a9af47ba9e2bb4dfebd75a6bdcf38e7cf2987904",
          "evidence": [
            "https://github.com/nix-purifiers/dotnet-purifier/blob/a9af47ba9e2bb4dfebd75a6bdcf38e7cf2987904/pkgs/dotnet-purifier/default.nix",
