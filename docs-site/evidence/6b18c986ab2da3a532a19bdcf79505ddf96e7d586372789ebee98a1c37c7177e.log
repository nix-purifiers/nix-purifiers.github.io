2026-11-07T06:33:14.3269755Z 
2026-11-07T06:33:14.3269862Z # sudo hint
2026-11-07T06:33:14.3270383Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:14.3270878Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T06:33:14.3271466Z     if [ -x /usr/bin/sudo ]; then
