2026-11-06T03:09:02.5404141Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:09:02.5404601Z 
2026-11-06T03:09:02.5404915Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:09:02.5405653Z # this file has to be sourced in /etc/profile.
2026-11-06T03:09:02.5405969Z 
2026-11-06T03:09:02.5406231Z # If not running interactively, don't do anything
2026-11-06T03:09:02.5406738Z [ -z "$PS1" ] && return
2026-11-06T03:09:02.5406993Z 
2026-11-06T03:09:02.5407315Z # check the window size after each command and, if necessary,
2026-11-06T03:09:02.5407917Z # update the values of LINES and COLUMNS.
2026-11-06T03:09:02.5408456Z shopt -s checkwinsize
2026-11-06T03:09:02.5408930Z 
2026-11-06T03:09:02.5409352Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:09:02.5410068Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:09:02.5410643Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:09:02.5411360Z fi
2026-11-06T03:09:02.5411528Z 
2026-11-06T03:09:02.5411852Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:09:02.5412484Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:09:02.5413105Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:09:02.5413701Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:09:02.5414232Z fi
2026-11-06T03:09:02.5414463Z 
2026-11-06T03:09:02.5414846Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:09:02.5415603Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:09:02.5416291Z #case "$TERM" in
2026-11-06T03:09:02.5416644Z #xterm*|rxvt*)
2026-11-06T03:09:02.5417072Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:09:02.5417496Z #    ;;
2026-11-06T03:09:02.5417807Z #*)
2026-11-06T03:09:02.5418149Z #    ;;
2026-11-06T03:09:02.5418436Z #esac
2026-11-06T03:09:02.5418655Z 
