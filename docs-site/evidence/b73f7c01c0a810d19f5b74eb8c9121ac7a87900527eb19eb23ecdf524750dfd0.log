# SPDX-License-Identifier: MIT
#
# Checks every pull request and every push to main, on x86_64-linux and
# aarch64-linux runners.
#
# `flake-check` builds the flake's checks: the conformance checks that run
# in the sandbox, the fixture project offline from its lockfile, the pinned
# real-world project, the meson-purifier command with its unit tests, and
# the formatting. The other jobs are the conformance checks of the purifier
# contract that need the network or Nix itself, under the same names:
#
#   conformance-relock    relocks the fixture and fails when the lockfile it
#                         writes differs from the committed one
#   conformance-rebuild   builds the fixture twice with `nix build --rebuild`
#                         and fails when the outputs differ
#   conformance-offline   runs the interactive commands and their error
#                         cases on copies of the fixture, without the
#                         network after `meson-purifier prefetch`
#   conformance-update    updates a fixture that pins an old zlib release
#                         and checks the new lockfile
name: check

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  portable-runtime:
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-latest
            system: x86_64-linux
            replica: one
            repro-mode: in-place
          - runner: macos-15
            system: aarch64-darwin
            replica: one
            repro-mode: fresh-store
          - runner: macos-15
            system: aarch64-darwin
            replica: two
            repro-mode: fresh-store
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
        with:
          extra_nix_config: sandbox = true
      - name: Lock, prefetch, ordinary Meson, and sandboxed runtime
        env:
          TIER2_EVIDENCE_DIR: ${{ runner.temp }}/meson-tier2-evidence
          TIER2_REPRO_MODE: ${{ matrix.repro-mode }}
          TIER2_REPLICA: ${{ matrix.replica }}
          TIER2_JOB_INDEX: ${{ strategy.job-index }}
        run: |
          test "$(nix eval --raw --impure --expr builtins.currentSystem)" = '${{ matrix.system }}'
          test "$(nix config show sandbox)" = true
          nix develop .#tier2 -c bash tests/tier2.sh
      - name: Independent pinned inih tests and installed-library consumer
        if: ${{ !cancelled() }}
        env:
          TIER2_EVIDENCE_DIR: ${{ runner.temp }}/meson-tier2-evidence
        run: nix develop .#tier2 -c bash tests/tier2-inih.sh
      - name: Diagnostic Nix in-place rebuild on Darwin (failure retained)
        if: ${{ !cancelled() && matrix.system == 'aarch64-darwin' && matrix.replica == 'one' }}
        continue-on-error: true
        env:
          TIER2_EVIDENCE_DIR: ${{ runner.temp }}/meson-tier2-evidence
        run: nix develop .#tier2 -c bash tests/rebuild-probe.sh
      - name: Preserve exact locks and tool versions
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: meson-runtime-${{ matrix.system }}-${{ matrix.replica }}
          path: ${{ runner.temp }}/meson-tier2-evidence
          if-no-files-found: error

  canonical-darwin-reproducibility:
    needs: portable-runtime
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
        with:
          extra_nix_config: sandbox = true
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: meson-runtime-aarch64-darwin-one
          path: receipts/one
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
        with:
          name: meson-runtime-aarch64-darwin-two
          path: receipts/two
      - name: Strict whole-output NAR equality from two native normal builds
        run: |
          nix config show sandbox > canonical-sandbox.txt
          test "$(cat canonical-sandbox.txt)" = true
          nix build --impure --option sandbox true --option allow-import-from-derivation false \
            --file tests/compare-repro.nix --argstr repository "$PWD" \
            --argstr first "$PWD/receipts/one" --argstr second "$PWD/receipts/two" \
            --out-link canonical-repro --print-build-logs
          nix path-info --json ./canonical-repro > canonical-output.json
          nix derivation show ./canonical-repro > canonical-derivation.json
          cp canonical-repro/result.json canonical-result.json
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: meson-canonical-darwin-comparison
          path: |
            canonical-*.json
            canonical-sandbox.txt
          if-no-files-found: error

  flake-check:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-latest, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
      - name: Build the checks
        run: nix flake check --print-build-logs
      - name: Evaluate the checks for every system
        run: nix flake check --all-systems --no-build

  conformance-relock:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-latest, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
      - name: Build the toolchain
        run: nix build '.#toolchain' --out-link toolchain
      - name: Relock the fixture
        run: nix shell 'nixpkgs#gcc' 'nixpkgs#pkg-config' -c tests/lock-run.sh toolchain

  conformance-rebuild:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-latest, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
      - name: Build the fixture
        run: |
          system=$(nix eval --raw --impure --expr builtins.currentSystem)
          echo "system=$system" >> "$GITHUB_ENV"
          nix build ".#checks.$system.fixture-tests" --print-build-logs
      - name: Build the fixture again and compare
        run: nix build ".#checks.$system.fixture-tests" --rebuild --print-build-logs

  conformance-offline:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-latest, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
      - name: Build the toolchain
        run: nix build '.#toolchain' --out-link toolchain
      - name: Run the interactive commands offline
        run: >
          nix shell 'nixpkgs#gcc' 'nixpkgs#pkg-config' 'nixpkgs#python3' 'nixpkgs#clang-tools'
          -c tests/interactive.sh toolchain

  conformance-update:
    strategy:
      fail-fast: false
      matrix:
        runner: [ubuntu-latest, ubuntu-24.04-arm]
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: cachix/install-nix-action@13d8dd58da0234aa297dedd986986ccb8e7f3e24 # v31
      - name: Build the toolchain
        run: nix build '.#toolchain' --out-link toolchain
      - name: Update the update fixture
        run: nix shell 'nixpkgs#gcc' 'nixpkgs#pkg-config' -c tests/update.sh toolchain
