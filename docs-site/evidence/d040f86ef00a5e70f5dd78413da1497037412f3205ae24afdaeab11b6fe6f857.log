2026-11-06T03:17:44.5639447Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-06T03:17:44.5639659Z 
2026-11-06T03:17:44.5639827Z # To enable the settings / commands in this file for login shells as well,
2026-11-06T03:17:44.5640177Z # this file has to be sourced in /etc/profile.
2026-11-06T03:17:44.5640350Z 
2026-11-06T03:17:44.5640458Z # If not running interactively, don't do anything
2026-11-06T03:17:44.5640731Z [ -z "$PS1" ] && return
2026-11-06T03:17:44.5640853Z 
2026-11-06T03:17:44.5640992Z # check the window size after each command and, if necessary,
2026-11-06T03:17:44.5641292Z # update the values of LINES and COLUMNS.
2026-11-06T03:17:44.5641485Z shopt -s checkwinsize
2026-11-06T03:17:44.5641563Z 
2026-11-06T03:17:44.5641680Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-06T03:17:44.5641963Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-06T03:17:44.5642160Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-06T03:17:44.5642306Z fi
2026-11-06T03:17:44.5642372Z 
2026-11-06T03:17:44.5642477Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-06T03:17:44.5642720Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-06T03:17:44.5642975Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-06T03:17:44.5643161Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-06T03:17:44.5643317Z fi
2026-11-06T03:17:44.5643375Z 
2026-11-06T03:17:44.5643487Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-06T03:17:44.5643721Z # If this is an xterm set the title to user@host:dir
2026-11-06T03:17:44.5643884Z #case "$TERM" in
2026-11-06T03:17:44.5644002Z #xterm*|rxvt*)
2026-11-06T03:17:44.5644179Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-06T03:17:44.5644378Z #    ;;
2026-11-06T03:17:44.5644477Z #*)
2026-11-06T03:17:44.5644576Z #    ;;
2026-11-06T03:17:44.5644675Z #esac
2026-11-06T03:17:44.5644734Z 
2026-11-06T03:17:44.5644812Z # enable bash completion in interactive shells
2026-11-06T03:17:44.5644993Z #if ! shopt -oq posix; then
2026-11-06T03:17:44.5645166Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-06T03:17:44.5645364Z #    . /usr/share/bash-completion/bash_completion
2026-11-06T03:17:44.5645537Z #  elif [ -f /etc/bash_completion ]; then
2026-11-06T03:17:44.5645692Z #    . /etc/bash_completion
2026-11-06T03:17:44.5645819Z #  fi
2026-11-06T03:17:44.5645917Z #fi
2026-11-06T03:17:44.5646198Z 
2026-11-06T03:17:44.5646273Z # sudo hint
2026-11-06T03:17:44.5646544Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T03:17:44.5646891Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T03:17:44.5647110Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T03:17:44.5647248Z 	cat <<-EOF
2026-11-06T03:17:44.5647618Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T03:17:44.5647822Z 	See "man sudo_root" for details.
2026-11-06T03:17:44.5648052Z 	
2026-11-06T03:17:44.5648151Z 	EOF
2026-11-06T03:17:44.5648253Z     fi
2026-11-06T03:17:44.5648356Z     esac
2026-11-06T03:17:44.5648454Z fi
2026-11-06T03:17:44.5648510Z 
2026-11-06T03:17:44.5648600Z # if the command-not-found package is installed, use it
2026-11-06T03:17:44.5648971Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:17:44.5649358Z 	function command_not_found_handle {
2026-11-06T03:17:44.5649640Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T03:17:44.5649960Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T03:17:44.5650233Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T03:17:44.5650470Z                    return $?
2026-11-06T03:17:44.5650798Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T03:17:44.5651314Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T03:17:44.5651537Z                    return $?
2026-11-06T03:17:44.5651662Z 		else
2026-11-06T03:17:44.5651782Z 		   printf "%s: command not found\n" "$1" >&2
