2026-11-06T02:56:31.6993762Z #fi
2026-11-06T02:56:31.6993871Z 
2026-11-06T02:56:31.6994016Z # sudo hint
2026-11-06T02:56:31.6994356Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-06T02:56:31.6994782Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-06T02:56:31.6995152Z     if [ -x /usr/bin/sudo ]; then
2026-11-06T02:56:31.6995415Z 	cat <<-EOF
2026-11-06T02:56:31.6996074Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-06T02:56:31.6996542Z 	See "man sudo_root" for details.
2026-11-06T02:56:31.6996810Z 	
2026-11-06T02:56:31.6997042Z 	EOF
2026-11-06T02:56:31.6997238Z     fi
2026-11-06T02:56:31.6997693Z     esac
2026-11-06T02:56:31.6997926Z fi
2026-11-06T02:56:31.6998045Z 
2026-11-06T02:56:31.6998211Z # if the command-not-found package is installed, use it
2026-11-06T02:56:31.6998744Z if [ -x /usr/lib/command-not-found -o -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:56:31.6999249Z 	function command_not_found_handle {
2026-11-06T02:56:31.6999811Z 	        # check because c-n-f could've been removed in the meantime
2026-11-06T02:56:31.7000274Z                 if [ -x /usr/lib/command-not-found ]; then
2026-11-06T02:56:31.7000615Z 		   /usr/lib/command-not-found -- "$1"
2026-11-06T02:56:31.7000925Z                    return $?
2026-11-06T02:56:31.7001290Z                 elif [ -x /usr/share/command-not-found/command-not-found ]; then
2026-11-06T02:56:31.7001767Z 		   /usr/share/command-not-found/command-not-found -- "$1"
2026-11-06T02:56:31.7002149Z                    return $?
2026-11-06T02:56:31.7002390Z 		else
2026-11-06T02:56:31.7002640Z 		   printf "%s: command not found\n" "$1" >&2
2026-11-06T02:56:31.7002992Z 		   return 127
2026-11-06T02:56:31.7003203Z 		fi
2026-11-06T02:56:31.7003417Z 	}
