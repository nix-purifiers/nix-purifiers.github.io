2026-11-07T06:33:15.1344576Z # System-wide .bashrc file for interactive bash(1) shells.
2026-11-07T06:33:15.1345021Z 
2026-11-07T06:33:15.1345369Z # To enable the settings / commands in this file for login shells as well,
2026-11-07T06:33:15.1346101Z # this file has to be sourced in /etc/profile.
2026-11-07T06:33:15.1346463Z 
2026-11-07T06:33:15.1346684Z # If not running interactively, don't do anything
2026-11-07T06:33:15.1347216Z [ -z "$PS1" ] && return
2026-11-07T06:33:15.1347454Z 
2026-11-07T06:33:15.1347729Z # check the window size after each command and, if necessary,
2026-11-07T06:33:15.1348346Z # update the values of LINES and COLUMNS.
2026-11-07T06:33:15.1348827Z shopt -s checkwinsize
2026-11-07T06:33:15.1349080Z 
2026-11-07T06:33:15.1349438Z # set variable identifying the chroot you work in (used in the prompt below)
2026-11-07T06:33:15.1350232Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-11-07T06:33:15.1350842Z     debian_chroot=$(cat /etc/debian_chroot)
2026-11-07T06:33:15.1351290Z fi
2026-11-07T06:33:15.1351450Z 
2026-11-07T06:33:15.1351755Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-11-07T06:33:15.1352524Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-11-07T06:33:15.1353200Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-11-07T06:33:15.1353535Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-11-07T06:33:15.1353902Z fi
2026-11-07T06:33:15.1354274Z 
2026-11-07T06:33:15.1354644Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-11-07T06:33:15.1355073Z # If this is an xterm set the title to user@host:dir
2026-11-07T06:33:15.1355387Z #case "$TERM" in
2026-11-07T06:33:15.1355843Z #xterm*|rxvt*)
2026-11-07T06:33:15.1356366Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-11-07T06:33:15.1356979Z #    ;;
2026-11-07T06:33:15.1357271Z #*)
2026-11-07T06:33:15.1357575Z #    ;;
2026-11-07T06:33:15.1357867Z #esac
2026-11-07T06:33:15.1358043Z 
2026-11-07T06:33:15.1358311Z # enable bash completion in interactive shells
2026-11-07T06:33:15.1359052Z #if ! shopt -oq posix; then
2026-11-07T06:33:15.1359421Z #  if [ -f /usr/share/bash-completion/bash_completion ]; then
2026-11-07T06:33:15.1359784Z #    . /usr/share/bash-completion/bash_completion
2026-11-07T06:33:15.1360087Z #  elif [ -f /etc/bash_completion ]; then
2026-11-07T06:33:15.1360354Z #    . /etc/bash_completion
2026-11-07T06:33:15.1360567Z #  fi
2026-11-07T06:33:15.1360731Z #fi
2026-11-07T06:33:15.1360827Z 
2026-11-07T06:33:15.1360900Z # sudo hint
2026-11-07T06:33:15.1361208Z if [ ! -e "$HOME/.sudo_as_admin_successful" ] && [ ! -e "$HOME/.hushlogin" ] ; then
2026-11-07T06:33:15.1361811Z     case " $(groups) " in *\ admin\ *|*\ sudo\ *)
2026-11-07T06:33:15.1362107Z     if [ -x /usr/bin/sudo ]; then
2026-11-07T06:33:15.1362337Z 	cat <<-EOF
2026-11-07T06:33:15.1362625Z 	To run a command as administrator (user "root"), use "sudo <command>".
2026-11-07T06:33:15.1362992Z 	See "man sudo_root" for details.
2026-11-07T06:33:15.1363220Z 	
